---
import BaseLayout from './BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  LayoutDashboard,
  GraduationCap,
  BarChart3,
  QrCode,
  LogOut,
  Menu,
  X,
} from 'lucide-astro';

const { title = 'Admin Portal - BCI' } = Astro.props;
const session = getSessionFromRequest(Astro.request);
if (!session || (session.role !== 'admin' && session.role !== 'teacher')) {
  return Astro.redirect('/login');
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col md:flex-row bg-slate-100/90 text-slate-900 relative">
    
    <!-- Mobile Top Navigation Header -->
    <header class="md:hidden flex items-center justify-between px-4 py-3 bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
      <div>
        <h2 class="font-bold text-sm text-slate-900 tracking-tight leading-none">BCI</h2>
        <p class="text-[10px] text-brand-600 font-bold mt-0.5">Admin Portal</p>
      </div>

      <!-- Hamburger Toggle Button -->
      <button
        id="mobile-sidebar-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 rounded-xl bg-slate-100 text-slate-700 hover:text-slate-900 border border-slate-200 transition focus:outline-none focus:ring-2 focus:ring-brand-500"
      >
        <Menu id="hamburger-open-icon" class="w-5 h-5 block" />
        <X id="hamburger-close-icon" class="w-5 h-5 hidden" />
      </button>
    </header>

    <!-- Mobile Drawer Backdrop -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden md:hidden transition-opacity duration-300 opacity-0"
    ></div>

    <!-- Sidebar Navigation -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-72 md:w-64 bg-black text-white flex-shrink-0 border-r border-zinc-800 flex flex-col justify-between transform -translate-x-full md:translate-x-0 md:static transition-transform duration-300 ease-in-out shadow-2xl md:shadow-none"
    >
      <div>
        <!-- Brand Header (Desktop) -->
        <div class="p-5 border-b border-zinc-800 hidden md:flex items-center justify-between bg-zinc-950">
          <div>
            <h2 class="font-bold text-base text-white tracking-tight leading-tight">BCI</h2>
            <p class="text-[11px] text-brand-400 font-bold flex items-center gap-1.5">
              <span>Admin Suite</span>
            </p>
          </div>
        </div>

        <!-- Mobile Drawer Header -->
        <div class="p-4 border-b border-zinc-800 flex md:hidden items-center justify-between bg-zinc-900">
          <span class="font-bold text-base text-white">BCI</span>
          <button id="close-drawer-btn" class="p-1.5 rounded-lg text-slate-400 hover:text-white bg-zinc-800 border border-zinc-700">
            <X class="w-4 h-4" />
          </button>
        </div>

        <!-- Admin Nav Items -->
        <nav class="p-3 space-y-1.5 text-xs font-bold">
          <a
            href="/admin"
            class={`flex items-center gap-3 px-3.5 py-3 rounded-xl transition ${
              currentPath === '/admin' || currentPath === '/admin/'
                ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30'
                : 'text-slate-300 hover:text-white hover:bg-zinc-900'
            }`}
          >
            <LayoutDashboard class={`w-4 h-4 ${currentPath === '/admin' || currentPath === '/admin/' ? 'text-white' : 'text-slate-400'}`} />
            <span>Dashboard Overview</span>
          </a>

          <a
            href="/admin/qr"
            class={`flex items-center gap-3 px-3.5 py-3 rounded-xl transition ${
              currentPath.startsWith('/admin/qr')
                ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30'
                : 'text-slate-300 hover:text-white hover:bg-zinc-900'
            }`}
          >
            <QrCode class={`w-4 h-4 ${currentPath.startsWith('/admin/qr') ? 'text-white' : 'text-slate-400'}`} />
            <span>Attendance QR</span>
          </a>

          <a
            href="/admin/students"
            class={`flex items-center gap-3 px-3.5 py-3 rounded-xl transition ${
              currentPath.startsWith('/admin/students')
                ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30'
                : 'text-slate-300 hover:text-white hover:bg-zinc-900'
            }`}
          >
            <GraduationCap class={`w-4 h-4 ${currentPath.startsWith('/admin/students') ? 'text-white' : 'text-slate-400'}`} />
            <span>Student Directory</span>
          </a>

          <a
            href="/admin/reports"
            class={`flex items-center gap-3 px-3.5 py-3 rounded-xl transition ${
              currentPath.startsWith('/admin/reports')
                ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30'
                : 'text-slate-300 hover:text-white hover:bg-zinc-900'
            }`}
          >
            <BarChart3 class={`w-4 h-4 ${currentPath.startsWith('/admin/reports') ? 'text-white' : 'text-slate-400'}`} />
            <span>Attendance Reports</span>
          </a>
        </nav>
      </div>

      <!-- User Info & Logout -->
      <div class="p-4 border-t border-zinc-800 bg-zinc-950">
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-xs">
              {session.name.charAt(0)}
            </div>
            <div class="truncate max-w-[130px]">
              <p class="text-xs font-bold text-white truncate">{session.name}</p>
              <p class="text-[10px] text-slate-400 truncate">Administrator</p>
            </div>
          </div>
        </div>

        <button
          id="admin-logout-btn"
          class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-xs font-bold text-white bg-crimson-600 hover:bg-crimson-700 border border-crimson-700 transition-all duration-200 active:scale-95 shadow-md shadow-crimson-600/20 cursor-pointer"
        >
          <LogOut class="w-3.5 h-3.5" />
          <span>Sign Out</span>
        </button>
      </div>
    </aside>

    <!-- Main Admin Content Area -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto bg-slate-50 text-slate-900 min-h-[calc(100vh-57px)] md:min-h-screen">
      <slot />
    </main>
  </div>

  <script>
    // Mobile hamburger sidebar toggle handling
    const toggleBtn = document.getElementById('mobile-sidebar-toggle');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const sidebar = document.getElementById('admin-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const openIcon = document.getElementById('hamburger-open-icon');
    const closeIcon = document.getElementById('hamburger-close-icon');

    function openSidebar() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
      }, 10);
      if (openIcon && closeIcon) {
        openIcon.classList.add('hidden');
        openIcon.classList.remove('block');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('block');
      }
    }

    function closeSidebar() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      setTimeout(() => {
        backdrop.classList.add('hidden');
      }, 300);
      if (openIcon && closeIcon) {
        openIcon.classList.remove('hidden');
        openIcon.classList.add('block');
        closeIcon.classList.add('hidden');
        closeIcon.classList.remove('block');
      }
    }

    toggleBtn?.addEventListener('click', () => {
      const isOpen = !sidebar?.classList.contains('-translate-x-full');
      if (isOpen) closeSidebar();
      else openSidebar();
    });

    closeDrawerBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);

    document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
      document.cookie = 'auth_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT;';
      document.cookie = 'auth_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; secure;';
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (err) {}
      window.location.replace('/login');
    });
  </script>
</BaseLayout>

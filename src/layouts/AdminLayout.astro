---
import BaseLayout from './BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  LayoutDashboard,
  GraduationCap,
  Users,
  BookOpen,
  BarChart3,
  ShieldCheck,
  LogOut,
  ExternalLink,
} from 'lucide-astro';


const { title = 'Admin Portal - Bhavya Computer Classes' } = Astro.props;
const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col md:flex-row bg-slate-900 text-slate-100">
    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-slate-950 text-white flex-shrink-0 border-r border-slate-800/80 flex flex-col justify-between">
      <div>
        <!-- Brand Header -->
        <div class="p-5 border-b border-slate-800/80 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white font-black flex items-center justify-center text-base shadow-lg shadow-brand-500/25 ring-2 ring-white/10">
              B
            </div>
            <div>
              <h2 class="font-bold text-sm text-white tracking-tight leading-tight">Bhavya Classes</h2>
              <p class="text-[11px] text-brand-400 font-semibold flex items-center gap-1">
                <span>Admin Suite</span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              </p>
            </div>
          </div>
        </div>

        <!-- Admin Nav Items -->
        <nav class="p-3 space-y-1 text-xs font-semibold">
          <a
            href="/admin"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-brand-600/20 text-brand-300 font-bold border border-brand-500/30 transition shadow-sm"
          >
            <LayoutDashboard class="w-4 h-4 text-brand-400" />
            <span>Dashboard Overview</span>
          </a>

          <a
            href="/admin#students"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition"
          >
            <GraduationCap class="w-4 h-4 text-slate-400" />
            <span>Student Directory</span>
          </a>

          <a
            href="/admin#teachers"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition"
          >
            <Users class="w-4 h-4 text-slate-400" />
            <span>Faculty & Teachers</span>
          </a>

          <a
            href="/admin#reports"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition"
          >
            <BarChart3 class="w-4 h-4 text-slate-400" />
            <span>Attendance Reports</span>
          </a>

          <a
            href="/admin#audit"
            class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition"
          >
            <ShieldCheck class="w-4 h-4 text-slate-400" />
            <span>Audit & Security Logs</span>
          </a>

          <div class="pt-2 pb-1 px-3">
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-600">Quick Links</span>
          </div>

          <a
            href="/teacher"
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-900 transition"
          >
            <span class="flex items-center gap-3">
              <BookOpen class="w-4 h-4 text-slate-400" />
              <span>Teacher Portal</span>
            </span>
            <ExternalLink class="w-3.5 h-3.5 text-slate-500" />
          </a>
        </nav>
      </div>

      <!-- User Info & Logout -->
      <div class="p-4 border-t border-slate-800/80 bg-slate-950/60">
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-xl bg-slate-800 text-slate-200 flex items-center justify-center font-bold text-xs">
              {session.name.charAt(0)}
            </div>
            <div class="truncate max-w-[120px]">
              <p class="text-xs font-bold text-white truncate">{session.name}</p>
              <p class="text-[10px] text-slate-400 truncate">Administrator</p>
            </div>
          </div>
        </div>

        <button
          id="admin-logout-btn"
          class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-rose-300 hover:text-white bg-rose-500/10 hover:bg-rose-600/80 border border-rose-500/20 transition-all duration-200 active:scale-95"
        >
          <LogOut class="w-3.5 h-3.5" />
          <span>Sign Out</span>
        </button>
      </div>
    </aside>

    <!-- Main Admin Content Area -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto bg-slate-900 text-slate-100">
      <slot />
    </main>
  </div>

  <script>
    document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</BaseLayout>


---
import BaseLayout from './BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { LayoutDashboard, ShieldCheck, LogOut } from 'lucide-astro';


const { title = 'Faculty Dashboard - Bhavya Computer Classes' } = Astro.props;
const session = getSessionFromRequest(Astro.request);
if (!session || (session.role !== 'teacher' && session.role !== 'admin')) {
  return Astro.redirect('/login');
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <header class="bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 text-white shadow-lg border-b border-indigo-900/60 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white flex items-center justify-center font-black text-lg shadow-md shadow-brand-500/30 ring-2 ring-white/10">
          {session.name.charAt(0)}
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-sm sm:text-base font-bold leading-tight">{session.name}</h1>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">Faculty</span>
          </div>
          <p class="text-xs text-slate-400 font-medium">Bhavya Computer Classes</p>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-4">
        <a
          href="/teacher"
          class={`flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl transition ${
            currentPath === '/teacher' || currentPath === '/teacher/'
              ? 'bg-white/15 text-white'
              : 'text-indigo-200 hover:text-white hover:bg-white/10'
          }`}
        >
          <LayoutDashboard class="w-4 h-4" />
          <span class="hidden sm:inline">Dashboard</span>
        </a>

        {session.role === 'admin' && (
          <a
            href="/admin"
            class="flex items-center gap-1.5 text-xs font-semibold text-indigo-200 hover:text-white hover:bg-white/10 px-3 py-1.5 rounded-xl transition"
          >
            <ShieldCheck class="w-4 h-4" />
            <span class="hidden sm:inline">Admin Portal</span>
          </a>
        )}

        <button
          id="teacher-logout-btn"
          class="flex items-center gap-1.5 text-xs font-semibold bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 border border-rose-500/30 px-3.5 py-1.5 rounded-xl transition active:scale-95"
          title="Sign Out"
        >
          <LogOut class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Logout</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 flex-1">
    <slot />
  </main>

  <script>
    document.getElementById('teacher-logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</BaseLayout>


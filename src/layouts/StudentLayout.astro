---
import BaseLayout from './BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { Home, Clock, LogOut } from 'lucide-astro';


const { title = 'Student Portal - BCI' } = Astro.props;
const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'student') {
  return Astro.redirect('/login');
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <!-- Top Responsive Header -->
  <header class="sticky top-0 z-30 bg-white border-b border-slate-200 py-3 shadow-sm transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-2xl bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-brand-600/25">
          {session.name.charAt(0)}
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="text-sm sm:text-base font-bold text-slate-900 leading-tight">{session.name}</h1>
          </div>
          <p class="text-[11px] sm:text-xs text-brand-600 font-bold flex items-center gap-1">
            <span>BCI</span>
            <span class="text-slate-300">•</span>
            <span class="text-slate-500 font-medium">Student</span>
          </p>
        </div>
      </div>

      <!-- Desktop Navigation Bar (Visible on md and larger) -->
      <nav class="hidden md:flex items-center gap-1.5 bg-slate-100 p-1 rounded-2xl border border-slate-200">
        <a
          href="/student"
          class={`flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-xs transition-all duration-200 ${
            currentPath === '/student' || currentPath === '/student/'
              ? 'bg-brand-600 text-white shadow-sm'
              : 'text-slate-700 hover:text-black hover:bg-white'
          }`}
        >
          <Home class="w-4 h-4" />
          <span>Dashboard</span>
        </a>
        <a
          href="/student/history"
          class={`flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-xs transition-all duration-200 ${
            currentPath.startsWith('/student/history')
              ? 'bg-brand-600 text-white shadow-sm'
              : 'text-slate-700 hover:text-black hover:bg-white'
          }`}
        >
          <Clock class="w-4 h-4" />
          <span>History</span>
        </a>
      </nav>

      <button
        id="logout-btn"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-crimson-600 hover:bg-crimson-700 px-3.5 py-2 rounded-xl border border-crimson-700 transition-all duration-200 active:scale-95 shadow-sm shadow-crimson-600/20 cursor-pointer"
        title="Sign Out"
      >
        <LogOut class="w-3.5 h-3.5" />
        <span class="hidden sm:inline">Sign Out</span>
      </button>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-24 md:pb-12">
    <slot />
  </main>

  <!-- Bottom Touch-Optimized Floating Glass Navigation Bar (Mobile only) -->
  <nav class="fixed bottom-0 left-0 right-0 z-30 bg-black text-white border-t border-zinc-800 shadow-xl md:hidden">
    <div class="max-w-md mx-auto flex justify-around items-center h-16 px-3">
      <a
        href="/student"
        class={`flex flex-col items-center justify-center flex-1 h-full font-bold text-xs gap-1 transition-all duration-200 ${
          currentPath === '/student' || currentPath === '/student/'
            ? 'text-brand-400'
            : 'text-slate-400 hover:text-white'
        }`}
      >
        <Home class="w-5 h-5" />
        <span class="text-[11px]">Home</span>
      </a>

      <a
        href="/student/history"
        class={`flex flex-col items-center justify-center flex-1 h-full font-bold text-xs gap-1 transition-all duration-200 ${
          currentPath.startsWith('/student/history')
            ? 'text-brand-400'
            : 'text-slate-400 hover:text-white'
        }`}
      >
        <Clock class="w-5 h-5" />
        <span class="text-[11px]">History</span>
      </a>
    </div>
  </nav>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      document.cookie = 'auth_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT;';
      document.cookie = 'auth_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; secure;';
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (err) {}
      window.location.replace('/login');
    });
  </script>
</BaseLayout>


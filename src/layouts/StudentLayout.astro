---
import BaseLayout from './BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { Home, Calendar, Clock, LogOut } from 'lucide-astro';


const { title = 'Student Portal - Bhavya Computer Classes' } = Astro.props;
const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'student') {
  return Astro.redirect('/login');
}

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <!-- Top Mobile App Header -->
  <header class="sticky top-0 z-30 bg-white/85 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 shadow-sm transition-all">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-brand-600 to-indigo-500 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-brand-500/25 ring-2 ring-white">
          {session.name.charAt(0)}
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="text-sm font-bold text-slate-900 leading-tight">{session.name}</h1>
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-white"></span>
          </div>
          <p class="text-[11px] text-brand-600 font-semibold flex items-center gap-1">
            <span>Bhavya Classes</span>
            <span class="text-slate-300">•</span>
            <span class="text-slate-500 font-medium">Student</span>
          </p>
        </div>
      </div>
      <button
        id="logout-btn"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-rose-600 bg-slate-100/80 hover:bg-rose-50 px-3 py-1.5 rounded-xl border border-slate-200/60 transition-all duration-200 active:scale-95"
        title="Sign Out"
      >
        <LogOut class="w-3.5 h-3.5" />
        <span class="hidden sm:inline">Sign out</span>
      </button>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 max-w-md mx-auto w-full px-4 pt-4 pb-24">
    <slot />
  </main>

  <!-- Bottom Touch-Optimized Floating Glass Navigation Bar -->
  <nav class="fixed bottom-0 left-0 right-0 z-30 bg-white/90 backdrop-blur-lg border-t border-slate-200/80 shadow-lg">
    <div class="max-w-md mx-auto flex justify-around items-center h-16 px-3">
      <a
        href="/student"
        class={`flex flex-col items-center justify-center flex-1 h-full font-semibold text-xs gap-1 transition-all duration-200 ${
          currentPath === '/student' || currentPath === '/student/'
            ? 'text-brand-600 scale-105'
            : 'text-slate-500 hover:text-brand-600'
        }`}
      >
        <div class={`p-1 rounded-xl transition ${currentPath === '/student' || currentPath === '/student/' ? 'bg-brand-50' : ''}`}>
          <Home class="w-5 h-5" />
        </div>
        <span class="text-[11px]">Home</span>
      </a>

      <a
        href="/student/schedule"
        class={`flex flex-col items-center justify-center flex-1 h-full font-semibold text-xs gap-1 transition-all duration-200 ${
          currentPath.startsWith('/student/schedule')
            ? 'text-brand-600 scale-105'
            : 'text-slate-500 hover:text-brand-600'
        }`}
      >
        <div class={`p-1 rounded-xl transition ${currentPath.startsWith('/student/schedule') ? 'bg-brand-50' : ''}`}>
          <Calendar class="w-5 h-5" />
        </div>
        <span class="text-[11px]">Schedule</span>
      </a>

      <a
        href="/student/history"
        class={`flex flex-col items-center justify-center flex-1 h-full font-semibold text-xs gap-1 transition-all duration-200 ${
          currentPath.startsWith('/student/history')
            ? 'text-brand-600 scale-105'
            : 'text-slate-500 hover:text-brand-600'
        }`}
      >
        <div class={`p-1 rounded-xl transition ${currentPath.startsWith('/student/history') ? 'bg-brand-50' : ''}`}>
          <Clock class="w-5 h-5" />
        </div>
        <span class="text-[11px]">History</span>
      </a>
    </div>
  </nav>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</BaseLayout>


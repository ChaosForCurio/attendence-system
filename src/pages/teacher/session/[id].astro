---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  LayoutDashboard,
  Grid,
  QrCode,
  ShieldCheck,
  LogOut,
  Search,
  Printer,
  Download,
  ChevronLeft,
  ChevronRight,
  Sparkles,
} from 'lucide-astro';


const session = getSessionFromRequest(Astro.request);
if (!session || (session.role !== 'teacher' && session.role !== 'admin')) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
---

<BaseLayout title="Live Attendance Classroom Grid - Bhavya Computer Classes">
  <div class="min-h-screen flex bg-slate-900 text-slate-100 font-sans antialiased">
    
    <!-- LEFT DARK SIDEBAR -->
    <aside class="w-16 md:w-20 bg-slate-950 flex flex-col items-center py-5 justify-between select-none flex-shrink-0 z-20 shadow-2xl border-r border-slate-800/80">
      <!-- Top Section -->
      <div class="flex flex-col items-center space-y-6 w-full">
        <!-- Logo -->
        <a
          href="/teacher"
          class="w-11 h-11 bg-gradient-to-tr from-brand-600 to-indigo-500 rounded-2xl flex items-center justify-center text-white font-black text-xs tracking-wider shadow-lg shadow-brand-500/30 hover:scale-105 transition"
        >
          BCC
        </a>

        <!-- User Avatar -->
        <div class="relative group cursor-pointer" title={session.name}>
          <div class="w-10 h-10 rounded-2xl bg-slate-800 border border-slate-700 overflow-hidden flex items-center justify-center text-white font-bold text-sm shadow">
            {session.name.charAt(0)}
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-slate-950 rounded-full"></span>
        </div>

        <!-- Navigation Icons -->
        <nav class="flex flex-col items-center space-y-4 text-slate-400 w-full px-2">
          <a
            href="/teacher"
            class="p-3 rounded-2xl text-slate-400 hover:text-white hover:bg-slate-800 transition"
            title="Faculty Dashboard"
          >
            <LayoutDashboard class="w-5 h-5" />
          </a>

          <a
            href="/teacher/session/sess_webdev_today"
            class="p-3 rounded-2xl bg-brand-600/20 text-brand-400 border border-brand-500/30 shadow-sm transition"
            title="Live Classroom Grid"
          >
            <Grid class="w-5 h-5" />
          </a>

          <button
            id="sidebar-qr-btn"
            class="p-3 rounded-2xl text-slate-400 hover:text-white hover:bg-slate-800 transition"
            title="Open Dynamic QR Code"
          >
            <QrCode class="w-5 h-5" />
          </button>

          {session.role === 'admin' && (
            <a
              href="/admin"
              class="p-3 rounded-2xl text-slate-400 hover:text-white hover:bg-slate-800 transition"
              title="Admin Settings"
            >
              <ShieldCheck class="w-5 h-5" />
            </a>
          )}
        </nav>
      </div>

      <!-- Sign Out Button -->
      <button
        id="sidebar-logout-btn"
        class="p-3 rounded-2xl text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition active:scale-95"
        title="Sign Out"
      >
        <LogOut class="w-5 h-5" />
      </button>
    </aside>

    <!-- MAIN CLASSROOM VIEW AREA -->
    <main class="flex-1 flex flex-col min-w-0 p-4 sm:p-6 lg:p-8 space-y-5 overflow-y-auto">
      
      <!-- TOP HEADER BAR -->
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-slate-800 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <h1 id="course-title" class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-tight">
              Web Development & Programming
            </h1>
            <span id="class-name-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-500/20 text-brand-300 border border-brand-500/30">
              Batch 2026-A
            </span>
          </div>
          <p class="text-xs font-semibold text-slate-400 mt-1">
            Bhavya Computer Classes • Lab 1 • Instructor: {session.name}
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button
            id="open-qr-top-btn"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs border border-white/10 transition active:scale-95"
          >
            <QrCode class="w-4 h-4 text-brand-400" />
            <span>Show QR Code</span>
          </button>
          
          <div class="flex items-center gap-2 bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 px-3 py-1.5 rounded-xl text-xs font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>LIVE SESSION ACTIVE</span>
          </div>
        </div>
      </div>

      <!-- TIME & ATTENDANCE SUMMARY HERO STRIP -->
      <div class="bg-slate-950 rounded-3xl p-5 border border-white/10 shadow-glass-dark flex flex-col md:flex-row items-center justify-between gap-6">
        
        <!-- Date Block -->
        <div class="flex items-center gap-4 text-center md:text-left pr-0 md:pr-6 border-b md:border-b-0 md:border-r border-slate-800 pb-4 md:pb-0 w-full md:w-auto">
          <div>
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 block mb-1">Today's Date</span>
            <h2 id="live-date" class="text-2xl font-black text-white leading-none">September 7</h2>
            <span class="text-xs font-bold text-brand-400 uppercase tracking-wider mt-1 block">Week 1 • Lab 1</span>
          </div>
        </div>

        <!-- Big Digital Clock -->
        <div class="flex flex-col items-center justify-center flex-1">
          <div id="live-clock" class="text-5xl sm:text-6xl lg:text-7xl font-bold text-rose-500 font-mono tracking-tight select-none drop-shadow-[0_0_20px_rgba(244,63,94,0.4)]">
            09:07 AM
          </div>
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold mt-1">Real-time Clock</span>
        </div>

        <!-- Attendance Metrics Box -->
        <div class="flex items-center gap-6 pl-0 md:pl-6 border-t md:border-t-0 md:border-l border-slate-800 pt-4 md:pt-0 w-full md:w-auto justify-center">
          <div class="text-center">
            <span class="text-[10px] font-bold uppercase text-slate-400 block mb-1">Attendance Health</span>
            <div class="flex items-center gap-5 mt-1">
              <div class="flex items-baseline gap-1.5">
                <span id="below-90-count" class="text-2xl font-black text-rose-400">1</span>
                <span class="text-[11px] font-semibold text-slate-400 leading-tight text-left">&lt; 90%<br><span class="text-[9px] text-slate-400">Critical</span></span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span id="below-95-count" class="text-2xl font-black text-amber-400">2</span>
                <span class="text-[11px] font-semibold text-slate-400 leading-tight text-left">&lt; 95%<br><span class="text-[9px] text-slate-400">Warning</span></span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- CONTROL TOOLBAR: DATE STRIP, SORTS, ACTIONS -->
      <div class="bg-slate-950 rounded-2xl p-3 border border-white/10 shadow-sm flex flex-wrap items-center justify-between gap-3 text-xs">
        
        <!-- Day Picker Strip -->
        <div class="flex items-center gap-1 bg-slate-900 p-1 rounded-xl border border-white/5">
          <button class="p-1 text-slate-400 hover:text-white transition">
            <ChevronLeft class="w-4 h-4" />
          </button>
          <div class="flex items-center gap-1">
            <div class="px-2.5 py-1 text-center rounded-lg bg-brand-600 font-bold text-white shadow-sm">
              <span class="block text-[8px] uppercase text-brand-200">MON</span> 7
            </div>
            <div class="px-2.5 py-1 text-center rounded-lg text-slate-400 font-medium hover:bg-slate-800 cursor-pointer">
              <span class="block text-[8px] uppercase text-slate-500">TUE</span> 8
            </div>
            <div class="px-2.5 py-1 text-center rounded-lg text-slate-400 font-medium hover:bg-slate-800 cursor-pointer">
              <span class="block text-[8px] uppercase text-slate-500">WED</span> 9
            </div>
            <div class="px-2.5 py-1 text-center rounded-lg text-slate-400 font-medium hover:bg-slate-800 cursor-pointer">
              <span class="block text-[8px] uppercase text-slate-500">THU</span> 10
            </div>
            <div class="px-2.5 py-1 text-center rounded-lg text-slate-400 font-medium hover:bg-slate-800 cursor-pointer">
              <span class="block text-[8px] uppercase text-slate-500">FRI</span> 11
            </div>
          </div>
          <button class="p-1 text-slate-400 hover:text-white transition">
            <ChevronRight class="w-4 h-4" />
          </button>
        </div>

        <!-- Sort and Filters -->
        <div class="flex items-center gap-4 flex-wrap">
          <div class="flex items-center gap-3 font-semibold text-slate-300">
            <span class="text-slate-400 font-bold">Sort:</span>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="sort-name" class="rounded bg-slate-800 border-slate-700 text-brand-600 focus:ring-0 cursor-pointer" />
              <span>Name</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="sort-attendance" class="rounded bg-slate-800 border-slate-700 text-brand-600 focus:ring-0 cursor-pointer" />
              <span>Attendance %</span>
            </label>
          </div>

          <label class="flex items-center gap-1.5 cursor-pointer bg-slate-900 px-3 py-1.5 rounded-xl border border-white/5 text-slate-300 font-semibold hover:bg-slate-800 transition">
            <input type="checkbox" id="select-all-present" class="rounded bg-slate-800 border-slate-700 text-emerald-500 focus:ring-0 cursor-pointer" />
            <span>Mark All Present</span>
          </label>
        </div>

        <!-- Print, Export & Search Actions -->
        <div class="flex items-center gap-2">
          <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold border border-white/5 transition">
            <Printer class="w-3.5 h-3.5" />
            <span>Print</span>
          </button>
          <a
            href="/api/admin/reports?format=csv"
            onclick="showToast('Exporting roster CSV...', 'success')"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold border border-white/5 transition"
          >
            <Download class="w-3.5 h-3.5 text-brand-400" />
            <span>Export</span>
          </a>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
              <Search class="w-3.5 h-3.5" />
            </div>
            <input
              type="text"
              id="search-box"
              placeholder="Search student..."
              class="pl-8 pr-3 py-1.5 rounded-xl bg-slate-900 border border-white/10 text-white placeholder-slate-500 text-xs focus:bg-slate-950 focus:outline-none focus:ring-2 focus:ring-brand-500 w-36 sm:w-44 font-medium transition"
            />
          </div>
        </div>

      </div>

      <!-- STUDENT CARDS 3-COLUMN GRID -->
      <div class="bg-slate-950/60 rounded-3xl p-4 sm:p-6 border border-white/10">
        <div id="cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Dynamic Student Cards Render Here -->
          <div class="col-span-full py-12 text-center text-slate-400 font-medium text-sm">
            Loading student classroom roster...
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Dynamic QR Modal -->
  <div id="qr-modal" class="hidden fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-white/10 rounded-3xl p-6 sm:p-8 max-w-sm w-full text-center space-y-6 shadow-2xl relative text-white">
      <button id="close-qr-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white font-bold text-lg p-1.5 rounded-xl hover:bg-slate-800 transition">✕</button>
      <div class="space-y-1.5">
        <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-widest text-brand-300 bg-brand-500/20 border border-brand-500/30 px-3 py-1 rounded-full">
          <Sparkles class="w-3 h-3" />
          DYNAMIC QR ATTENDANCE
        </span>
        <h3 class="text-xl font-black text-white">Scan to Mark Present</h3>
        <p class="text-xs text-slate-400 font-medium">Expires automatically every 20 seconds</p>
      </div>

      <div class="p-6 bg-slate-950 border border-white/10 rounded-2xl flex flex-col items-center justify-center space-y-3 shadow-inner">
        <div id="qr-display" class="w-48 h-48 bg-white p-4 rounded-2xl flex items-center justify-center text-slate-900 font-mono text-xs break-all font-bold shadow-lg">
          Generating QR...
        </div>
        <div class="flex items-center gap-2 text-[11px] font-bold text-emerald-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Live Token Active</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    const sessionId = window.location.pathname.split('/').pop() || 'sess_webdev_today';
    let studentsData: any[] = [];

    // Live Digital Clock
    function updateClock() {
      const now = new Date();
      let hours = now.getHours();
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12 || 12;
      const hoursStr = String(hours);
      
      const clockEl = document.getElementById('live-clock');
      if (clockEl) {
        clockEl.textContent = `${hoursStr}:${minutes} ${ampm}`;
      }

      const dateEl = document.getElementById('live-date');
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
      }
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Fetch Live Roster Data
    async function loadRoster() {
      try {
        const res = await fetch(`/api/teacher/session-detail?id=${sessionId}`);
        if (!res.ok) return;

        const data = await res.json();
        
        if (data.session) {
          document.getElementById('course-title')!.textContent = data.session.subjectName;
          document.getElementById('class-name-badge')!.textContent = data.session.className;
        }

        // Calculate attendance percentages for demo presentation
        studentsData = (data.students || []).map((s: any, idx: number) => {
          const samplePercentages = [97, 96, 89, 91, 95, 96, 97, 93, 99];
          const pct = samplePercentages[idx % samplePercentages.length];
          return {
            ...s,
            percentage: pct,
          };
        });

        // Count below 90% and 95%
        const below90 = studentsData.filter(s => s.percentage < 90).length;
        const below95 = studentsData.filter(s => s.percentage >= 90 && s.percentage < 95).length;
        document.getElementById('below-90-count')!.textContent = String(below90);
        document.getElementById('below-95-count')!.textContent = String(below95);

        renderGrid(studentsData);
      } catch (err) {
        console.error('Error loading roster:', err);
      }
    }

    // Render Student Cards Grid
    function renderGrid(students: any[]) {
      const grid = document.getElementById('cards-grid')!;
      if (!students || students.length === 0) {
        grid.innerHTML = '<div class="col-span-full py-8 text-center text-slate-400">No students found matching criteria.</div>';
        return;
      }

      const sampleAvatars = [
        'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80',
        'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80',
      ];

      grid.innerHTML = students.map((st, i) => {
        const isPresent = st.status === 'present' || st.status === 'late';
        const isAbsent = st.status === 'absent';
        const pct = st.percentage || 95;

        // Colored ring based on percentage
        let ringColor = 'border-emerald-500 shadow-emerald-500/20';
        let pctColor = 'text-emerald-400';
        if (pct < 90) {
          ringColor = 'border-rose-500 shadow-rose-500/20';
          pctColor = 'text-rose-400';
        } else if (pct < 95) {
          ringColor = 'border-amber-500 shadow-amber-500/20';
          pctColor = 'text-amber-400';
        }

        const firstName = st.name.split(' ')[0];
        const avatarUrl = sampleAvatars[i % sampleAvatars.length];

        return `
          <div class="bg-slate-900 rounded-3xl p-3.5 border border-white/10 shadow-md flex items-center justify-between relative hover:border-brand-500/40 hover:shadow-glow-primary transition duration-200">
            
            <!-- Edit Icon top-left -->
            <button
              data-std-id="${st.studentId}"
              class="edit-student-btn absolute top-3 left-3 text-slate-500 hover:text-white transition p-1"
              title="Override Attendance"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </button>

            <!-- Percentage top-right -->
            <div class="absolute top-3 right-14 text-xs font-bold ${pctColor}">
              ${pct}%
            </div>

            <!-- Left: Avatar + Name -->
            <div class="flex items-center gap-3.5 pl-6 py-1">
              <div class="relative w-13 h-13 rounded-full border-2 ${ringColor} p-0.5 flex-shrink-0 shadow">
                <img
                  src="${avatarUrl}"
                  alt="${st.name}"
                  class="w-full h-full rounded-full object-cover"
                />
              </div>

              <div>
                <h3 class="text-sm font-bold text-white leading-tight">${firstName}</h3>
                <p class="text-[10px] text-slate-400 font-semibold font-mono">${st.studentNumber || 'BCC2026'}</p>
              </div>
            </div>

            <!-- Right: AM / PM Toggles Strip -->
            <div class="flex flex-col border-l border-white/10 divide-y divide-white/10 text-[11px] font-bold">
              <button
                data-std-id="${st.studentId}"
                data-target-status="${isPresent ? 'absent' : 'present'}"
                class="am-toggle-btn px-3.5 py-2.5 rounded-tr-2xl ${isPresent ? 'bg-emerald-500/20 text-emerald-300 font-extrabold' : 'text-slate-400 hover:bg-white/5'} transition active:scale-95"
                title="Toggle AM Attendance"
              >
                ${isPresent ? '✓ AM' : 'AM'}
              </button>
              <button
                data-std-id="${st.studentId}"
                class="pm-toggle-btn px-3.5 py-2.5 rounded-br-2xl ${isAbsent ? 'bg-rose-500/20 text-rose-300 font-extrabold' : 'text-slate-400 hover:bg-white/5'} transition active:scale-95"
                title="Toggle PM Attendance"
              >
                ${isAbsent ? '✕ PM' : 'PM'}
              </button>
            </div>

          </div>
        `;
      }).join('');

      // AM Toggle Button Click
      document.querySelectorAll('.am-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const stdId = btn.getAttribute('data-std-id');
          const targetStatus = btn.getAttribute('data-target-status') || 'present';
          await updateAttendanceStatus(stdId!, targetStatus);
        });
      });

      // Edit Button Click
      document.querySelectorAll('.edit-student-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const stdId = btn.getAttribute('data-std-id');
          const newStatus = prompt('Update Status (present / late / absent / excused):', 'present');
          if (newStatus && ['present', 'late', 'absent', 'excused'].includes(newStatus)) {
            updateAttendanceStatus(stdId!, newStatus);
          }
        });
      });
    }

    async function updateAttendanceStatus(studentId: string, status: string) {
      try {
        const res = await fetch('/api/teacher/override', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId, studentId, status }),
        });
        if (res.ok) {
          (window as any).showToast?.(`Attendance updated to ${status}`, 'success', 2000);
          loadRoster();
        }
      } catch (e) {
        (window as any).showToast?.('Update failed', 'error');
      }
    }

    // Search Box
    document.getElementById('search-box')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      const filtered = studentsData.filter(s => s.name.toLowerCase().includes(q) || s.studentNumber.toLowerCase().includes(q));
      renderGrid(filtered);
    });

    // Sort by Name
    document.getElementById('sort-name')?.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).checked) {
        const sorted = [...studentsData].sort((a, b) => a.name.localeCompare(b.name));
        renderGrid(sorted);
      } else {
        renderGrid(studentsData);
      }
    });

    // Sort by Attendance %
    document.getElementById('sort-attendance')?.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).checked) {
        const sorted = [...studentsData].sort((a, b) => b.percentage - a.percentage);
        renderGrid(sorted);
      } else {
        renderGrid(studentsData);
      }
    });

    // Select All Present
    document.getElementById('select-all-present')?.addEventListener('change', async (e) => {
      if ((e.target as HTMLInputElement).checked) {
        for (const st of studentsData) {
          await updateAttendanceStatus(st.studentId, 'present');
        }
        (window as any).showToast?.('Marked all students present', 'success');
      }
    });

    // QR Modal Controls
    const qrModal = document.getElementById('qr-modal')!;
    const openQr = () => {
      qrModal.classList.remove('hidden');
      updateQrToken();
    };

    document.getElementById('sidebar-qr-btn')?.addEventListener('click', openQr);
    document.getElementById('open-qr-top-btn')?.addEventListener('click', openQr);
    document.getElementById('close-qr-modal')?.addEventListener('click', () => {
      qrModal.classList.add('hidden');
    });

    async function updateQrToken() {
      try {
        const res = await fetch(`/api/teacher/qr?sessionId=${sessionId}`);
        if (res.ok) {
          const data = await res.json();
          document.getElementById('qr-display')!.textContent = `BCC-SECURE-QR:\n${data.token.substring(0, 24)}...`;
        }
      } catch (e) {}
    }

    // Logout Button
    document.getElementById('sidebar-logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });

    loadRoster();
    setInterval(loadRoster, 10000);
  </script>
</BaseLayout>


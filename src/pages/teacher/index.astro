---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  Calendar,
  Play,
  LogOut,
  ShieldCheck,
  LayoutDashboard,
  Grid,
} from 'lucide-astro';


const session = getSessionFromRequest(Astro.request);
if (!session || (session.role !== 'teacher' && session.role !== 'admin')) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Faculty Portal - Bhavya Computer Classes">
  <div class="min-h-screen flex bg-slate-900 text-slate-100 font-sans antialiased">
    
    <!-- LEFT DARK SIDEBAR -->
    <aside class="w-16 md:w-20 bg-slate-950 flex flex-col items-center py-5 justify-between select-none flex-shrink-0 z-20 shadow-2xl border-r border-slate-800/80">
      <div class="flex flex-col items-center space-y-6 w-full">
        <a
          href="/teacher"
          class="w-11 h-11 bg-gradient-to-tr from-brand-600 to-indigo-500 rounded-2xl flex items-center justify-center text-white font-black text-xs tracking-wider shadow-lg shadow-brand-500/30 hover:scale-105 transition"
        >
          BCC
        </a>

        <div class="relative group cursor-pointer" title={session.name}>
          <div class="w-10 h-10 rounded-2xl bg-slate-800 border border-slate-700 overflow-hidden flex items-center justify-center text-white font-bold text-sm shadow">
            {session.name.charAt(0)}
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-slate-950 rounded-full"></span>
        </div>

        <nav class="flex flex-col items-center space-y-4 text-slate-400 w-full px-2">
          <a
            href="/teacher"
            class="p-3 rounded-2xl bg-brand-600/20 text-brand-400 border border-brand-500/30 shadow-sm transition"
            title="Classes & Attendance"
          >
            <LayoutDashboard class="w-5 h-5" />
          </a>

          <a
            href="/teacher/session/sess_webdev_today"
            class="p-3 rounded-2xl text-slate-400 hover:text-white hover:bg-slate-800 transition"
            title="Live Classroom Grid"
          >
            <Grid class="w-5 h-5" />
          </a>

          {session.role === 'admin' && (
            <a
              href="/admin"
              class="p-3 rounded-2xl text-slate-400 hover:text-white hover:bg-slate-800 transition"
              title="Admin Settings"
            >
              <ShieldCheck class="w-5 h-5" />
            </a>
          )}
        </nav>
      </div>

      <button
        id="teacher-logout-btn"
        class="p-3 rounded-2xl text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition active:scale-95"
        title="Sign Out"
      >
        <LogOut class="w-5 h-5" />
      </button>
    </aside>

    <!-- MAIN DASHBOARD CONTENT -->
    <main class="flex-1 flex flex-col min-w-0 p-4 sm:p-6 lg:p-8 space-y-6 overflow-y-auto">
      
      <!-- Top Title Bar -->
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-slate-800 pb-5">
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Faculty Dashboard</h1>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-500/20 text-brand-300 border border-brand-500/30">
              Active Instructor
            </span>
          </div>
          <p class="text-xs font-semibold text-slate-400 mt-1">Bhavya Computer Classes • Academic Year 2026</p>
        </div>

        <a
          href="/teacher/session/sess_webdev_today"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 text-white font-bold text-xs shadow-lg shadow-rose-600/30 hover:shadow-glow-danger transition active:scale-95"
        >
          <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
          <span>Open Live Classroom Grid</span>
        </a>
      </div>

      <!-- Quick Launch Live Session Hero Banner -->
      <div class="relative bg-gradient-to-r from-slate-950 via-slate-900 to-indigo-950 rounded-3xl p-6 sm:p-8 border border-white/10 shadow-glass-dark overflow-hidden">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-widest bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 px-3 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                LIVE SESSION IN PROGRESS
              </span>
              <span class="text-xs font-bold text-slate-400">Lab 1 • Computer Center</span>
            </div>
            
            <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">
              Web Development & Full Stack Programming
            </h2>
            <p class="text-xs text-slate-300 font-medium">
              Batch 2026-A • Scheduled 09:00 AM – 11:59 AM • 9 Active Students
            </p>
          </div>

          <a
            href="/teacher/session/sess_webdev_today"
            class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-bold text-sm shadow-xl shadow-brand-600/30 hover:shadow-glow-primary transition active:scale-95"
          >
            <span>Launch Attendance Grid</span>
            <span class="text-lg">→</span>
          </a>
        </div>
      </div>

      <!-- Today's Schedule Batches -->
      <div class="space-y-3.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
            <Calendar class="w-4 h-4 text-brand-400" />
            <span>Today's Assigned Batches</span>
          </h3>
          <span class="text-xs text-slate-400">3 Sessions Total</span>
        </div>
        
        <div class="grid grid-cols-1 gap-3">
          
          <!-- Batch 1 (Active) -->
          <div class="p-4 sm:p-5 rounded-3xl bg-slate-950/70 border border-brand-500/40 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="text-xs font-bold text-brand-300 bg-brand-950 px-3.5 py-2 rounded-2xl border border-brand-500/30 font-mono">
                09:00 – 10:00
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="text-sm sm:text-base font-bold text-white">Web Development & Programming</h4>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Active</span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Batch 2026-A • Computer Lab 1</p>
              </div>
            </div>

            <a
              href="/teacher/session/sess_webdev_today"
              class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow transition active:scale-95"
            >
              <Grid class="w-4 h-4" />
              <span>Live Monitor</span>
            </a>
          </div>

          <!-- Batch 2 -->
          <div class="p-4 sm:p-5 rounded-3xl bg-slate-950/50 border border-white/10 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="text-xs font-bold text-slate-400 bg-slate-900 px-3.5 py-2 rounded-2xl border border-white/10 font-mono">
                10:00 – 11:00
              </div>
              <div>
                <h4 class="text-sm sm:text-base font-bold text-white">Python Programming & Data Science</h4>
                <p class="text-xs text-slate-400 mt-0.5">Batch 2026-A • Computer Lab 1</p>
              </div>
            </div>

            <button
              onclick="showToast('Starting Python session...', 'info')"
              class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-4 py-2.5 rounded-xl border border-white/10 transition active:scale-95"
            >
              <Play class="w-3.5 h-3.5" />
              <span>Start Session</span>
            </button>
          </div>

          <!-- Batch 3 -->
          <div class="p-4 sm:p-5 rounded-3xl bg-slate-950/50 border border-white/10 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="text-xs font-bold text-slate-400 bg-slate-900 px-3.5 py-2 rounded-2xl border border-white/10 font-mono">
                11:00 – 12:00
              </div>
              <div>
                <h4 class="text-sm sm:text-base font-bold text-white">Tally Prime & GST Accounting</h4>
                <p class="text-xs text-slate-400 mt-0.5">Batch 2026-A • Computer Lab 2</p>
              </div>
            </div>

            <button
              onclick="showToast('Starting Tally Prime session...', 'info')"
              class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-4 py-2.5 rounded-xl border border-white/10 transition active:scale-95"
            >
              <Play class="w-3.5 h-3.5" />
              <span>Start Session</span>
            </button>
          </div>

        </div>
      </div>

    </main>
  </div>

  <script>
    document.getElementById('teacher-logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    });
  </script>
</BaseLayout>


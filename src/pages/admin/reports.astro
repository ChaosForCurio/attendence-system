---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  BarChart3,
  Download,
  Search,
  UserCheck,
  UserX,
  Sparkles,
} from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="Attendance Reports - Bhavya Computer Classes">
  <div class="space-y-6">
    
    <!-- Top Bar Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Attendance Reports</h1>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80">
            Analytics &amp; Export
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">Review student attendance metrics, verification logs, and generate institutional PDF reports</p>
      </div>

      <button
        id="export-pdf-btn"
        onclick="downloadPDF()"
        class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-500 active:bg-rose-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md shadow-rose-600/20 transition active:scale-95 whitespace-nowrap cursor-pointer"
      >
        <Download class="w-4 h-4" />
        <span>Export PDF Report</span>
      </button>
    </div>

    <!-- Attendance Stats Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Total Logs Recorded</span>
          <span id="stat-total-logs" class="text-2xl font-black text-slate-900">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-indigo-50 text-indigo-600">
          <BarChart3 class="w-5 h-5" />
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Present Count</span>
          <span id="stat-present-count" class="text-2xl font-black text-emerald-600">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-emerald-50 text-emerald-600">
          <UserCheck class="w-5 h-5" />
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Absent Count</span>
          <span id="stat-absent-count" class="text-2xl font-black text-rose-600">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-rose-50 text-rose-600">
          <UserX class="w-5 h-5" />
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Attendance Rate</span>
          <span id="stat-rate" class="text-2xl font-black text-brand-600">--%</span>
        </div>
        <div class="p-2.5 rounded-xl bg-brand-50 text-brand-600">
          <Sparkles class="w-5 h-5" />
        </div>
      </div>
    </div>

    <!-- Filter Controls & Report Table -->
    <div class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <Search class="w-4 h-4" />
          </div>
          <input
            type="text"
            id="reports-search-input"
            placeholder="Search by student name, ID, class, or subject..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 transition font-medium"
          />
        </div>

        <div class="flex items-center gap-2">
          <select
            id="status-filter"
            class="px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
          >
            <option value="all">All Statuses</option>
            <option value="present">Present Only</option>
            <option value="absent">Absent Only</option>
          </select>
        </div>
      </div>

      <!-- Report Table -->
      <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold tracking-wider border-b border-slate-200">
            <tr>
              <th class="p-4">Date</th>
              <th class="p-4">Time</th>
              <th class="p-4">Student Name</th>
              <th class="p-4">Student Roll No</th>
              <th class="p-4">Class &amp; Subject</th>
              <th class="p-4">Status</th>
              <th class="p-4">Method</th>
            </tr>
          </thead>
          <tbody id="reports-table-body" class="divide-y divide-slate-200/60 font-medium">
            <tr>
              <td colspan="7" class="p-6 text-center text-slate-400">Loading attendance reports...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- jsPDF + AutoTable CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

  <script>
    let allReports: any[] = [];

    async function loadReports() {
      try {
        const res = await fetch('/api/admin/reports');
        if (res.ok) {
          const data = await res.json();
          allReports = data.reports || [];
        } else {
          allReports = [];
        }
      } catch (err) {
        console.error('Failed to load reports:', err);
        allReports = [];
      }
      updateReportStats(allReports);
      renderReports(allReports);
    }

    function updateReportStats(reports: any[]) {
      const total = reports.length;
      const present = reports.filter(r => r.status === 'present').length;
      const absent = reports.filter(r => r.status === 'absent').length;
      const rate = total > 0 ? ((present / total) * 100).toFixed(1) : '88.5';

      document.getElementById('stat-total-logs')!.textContent = total.toString();
      document.getElementById('stat-present-count')!.textContent = present.toString();
      document.getElementById('stat-absent-count')!.textContent = absent.toString();
      document.getElementById('stat-rate')!.textContent = `${rate}%`;
    }

    function renderReports(reports: any[]) {
      const tbody = document.getElementById('reports-table-body')!;
      if (reports.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-6 text-center text-slate-500 font-medium">No attendance logs found matching filters.</td></tr>';
        return;
      }

      tbody.innerHTML = reports.map((r: any) => {
        // Format time from markedAt timestamp
        const markedAtTime = r.markedAt
          ? new Date(r.markedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true })
          : '--:-- --';

        return `
        <tr class="hover:bg-slate-50/80 transition text-slate-900">
          <td class="p-4 text-slate-500 font-mono text-xs">${r.date || 'Today'}</td>
          <td class="p-4 text-slate-600 font-mono text-xs whitespace-nowrap">${markedAtTime}</td>
          <td class="p-4 font-bold text-slate-900">${r.studentName}</td>
          <td class="p-4 text-slate-600 font-mono text-xs">${r.studentNumber}</td>
          <td class="p-4 text-slate-700 font-medium">
            <span class="font-bold text-slate-900 block">${r.className}</span>
            <span class="text-[10px] text-brand-600 font-bold">${r.subjectName || 'General'}</span>
          </td>
          <td class="p-4">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold ${r.status === 'present' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-rose-100 text-rose-800 border border-rose-200'}">
              ${r.status ? r.status.toUpperCase() : 'PRESENT'}
            </span>
          </td>
          <td class="p-4">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-100 text-slate-700 border border-slate-200 uppercase font-bold">
              ${r.method || 'QR'}
            </span>
          </td>
        </tr>
      `}).join('');
    }

    // ─── PDF Export ─────────────────────────────────────────────────────────────
    async function downloadPDF() {
      const btn = document.getElementById('export-pdf-btn') as HTMLButtonElement;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg><span>Generating PDF...</span>';
      btn.disabled = true;

      try {
        // Fetch fresh data from API
        let reports: any[] = allReports;
        try {
          const res = await fetch('/api/admin/reports');
          if (res.ok) {
            const data = await res.json();
            if (data.reports && data.reports.length > 0) reports = data.reports;
          }
        } catch (_) { /* use cached allReports */ }

        // Ensure jsPDF is loaded
        const { jsPDF } = (window as any).jspdf;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });

        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const margin = 14;
        const now = new Date();
        const generatedAt = now.toLocaleString('en-IN', {
          day: '2-digit', month: 'long', year: 'numeric',
          hour: '2-digit', minute: '2-digit', hour12: true
        });

        // ── Header bar ──────────────────────────────────────────────────────────
        doc.setFillColor(30, 41, 59);           // slate-800
        doc.rect(0, 0, pageW, 22, 'F');

        doc.setTextColor(255, 255, 255);
        doc.setFontSize(16);
        doc.setFont('helvetica', 'bold');
        doc.text('Bhavya Computer Classes', margin, 10);

        doc.setFontSize(8);
        doc.setFont('helvetica', 'normal');
        doc.text('Attendance Management System', margin, 16);

        // Report title (right-aligned)
        doc.setFontSize(11);
        doc.setFont('helvetica', 'bold');
        doc.text('ATTENDANCE REPORT', pageW - margin, 10, { align: 'right' });
        doc.setFontSize(7);
        doc.setFont('helvetica', 'normal');
        doc.text(`Generated: ${generatedAt}`, pageW - margin, 16, { align: 'right' });

        // ── Summary stats row ────────────────────────────────────────────────────
        const total   = reports.length;
        const present = reports.filter((r: any) => r.status === 'present').length;
        const absent  = reports.filter((r: any) => r.status === 'absent').length;
        const rate    = total > 0 ? ((present / total) * 100).toFixed(1) : '0.0';

        const statsY = 28;
        const statBoxW = (pageW - margin * 2 - 9) / 4;
        const statBoxH = 18;

        const stats = [
          { label: 'Total Logs',      value: total.toString(),   color: [79, 70, 229] as [number,number,number] },   // indigo
          { label: 'Present',         value: present.toString(), color: [5, 150, 105] as [number,number,number] },   // emerald
          { label: 'Absent',          value: absent.toString(),  color: [220, 38, 38] as [number,number,number] },   // red
          { label: 'Attendance Rate', value: `${rate}%`,         color: [124, 58, 237] as [number,number,number] },  // violet
        ];

        stats.forEach((s, i) => {
          const x = margin + i * (statBoxW + 3);
          // Card background
          doc.setFillColor(248, 250, 252);        // slate-50
          doc.setDrawColor(226, 232, 240);        // slate-200
          doc.roundedRect(x, statsY, statBoxW, statBoxH, 2, 2, 'FD');

          // Accent left strip
          doc.setFillColor(...s.color);
          doc.roundedRect(x, statsY, 3, statBoxH, 1, 1, 'F');

          // Label
          doc.setTextColor(100, 116, 139);       // slate-500
          doc.setFontSize(6.5);
          doc.setFont('helvetica', 'bold');
          doc.text(s.label.toUpperCase(), x + 6, statsY + 6);

          // Value
          doc.setTextColor(...s.color);
          doc.setFontSize(14);
          doc.setFont('helvetica', 'bold');
          doc.text(s.value, x + 6, statsY + 15);
        });

        // ── Section divider ──────────────────────────────────────────────────────
        const tableStartY = statsY + statBoxH + 6;
        doc.setTextColor(51, 65, 85);            // slate-700
        doc.setFontSize(8);
        doc.setFont('helvetica', 'bold');
        doc.text('DETAILED ATTENDANCE LOG', margin, tableStartY);
        doc.setDrawColor(203, 213, 225);         // slate-300
        doc.setLineWidth(0.3);
        doc.line(margin + 60, tableStartY - 1, pageW - margin, tableStartY - 1);

        // ── Main data table ─────────────────────────────────────────────────────
        const tableRows = reports.map((r: any) => {
          const timeStr = r.markedAt
            ? new Date(r.markedAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true })
            : '--:--';
          return [
            r.date || '—',
            timeStr,
            r.studentName || '—',
            r.studentNumber || '—',
            `${r.className || '—'}\n${r.subjectName || 'General'}`,
            (r.status || 'present').toUpperCase(),
            (r.method || 'QR').toUpperCase(),
          ];
        });

        (doc as any).autoTable({
          startY: tableStartY + 3,
          margin: { left: margin, right: margin },
          head: [['Date', 'Time', 'Student Name', 'Roll No', 'Class / Subject', 'Status', 'Method']],
          body: tableRows,
          styles: {
            fontSize: 8,
            cellPadding: { top: 3, right: 4, bottom: 3, left: 4 },
            font: 'helvetica',
            textColor: [30, 41, 59],
            lineColor: [226, 232, 240],
            lineWidth: 0.3,
          },
          headStyles: {
            fillColor: [30, 41, 59],             // slate-800
            textColor: [255, 255, 255],
            fontStyle: 'bold',
            fontSize: 7.5,
            halign: 'center',
          },
          alternateRowStyles: {
            fillColor: [248, 250, 252],          // slate-50
          },
          columnStyles: {
            0: { cellWidth: 24, halign: 'center', fontStyle: 'normal', textColor: [100, 116, 139] },  // Date
            1: { cellWidth: 20, halign: 'center', textColor: [100, 116, 139] },                        // Time
            2: { cellWidth: 44, fontStyle: 'bold' },                                                   // Name
            3: { cellWidth: 28, halign: 'center', fontStyle: 'normal', textColor: [100, 116, 139] },  // Roll No
            4: { cellWidth: 'auto' },                                                                  // Class/Subject
            5: { cellWidth: 22, halign: 'center' },                                                   // Status
            6: { cellWidth: 20, halign: 'center', textColor: [100, 116, 139] },                       // Method
          },
          didDrawCell: (hookData: any) => {
            // Colour the Status cell
            if (hookData.section === 'body' && hookData.column.index === 5) {
              const val = hookData.cell.raw as string;
              const isPresent = val === 'PRESENT';
              const { x, y, width, height } = hookData.cell;
              const pad = 2;
              const bw = width - pad * 2;
              const bh = height - pad * 2;

              doc.setFillColor(isPresent ? 209 : 254, isPresent ? 250 : 202, isPresent ? 229 : 202);
              doc.setDrawColor(isPresent ? 16 : 220, isPresent ? 185 : 38, isPresent ? 129 : 38);
              doc.setLineWidth(0.3);
              doc.roundedRect(x + pad, y + pad, bw, bh, 2, 2, 'FD');

              doc.setTextColor(isPresent ? 5 : 153, isPresent ? 121 : 27, isPresent ? 56 : 27);
              doc.setFontSize(7);
              doc.setFont('helvetica', 'bold');
              doc.text(val, x + width / 2, y + height / 2 + 1, { align: 'center' });
            }
          },
          // Page numbers in footer
          didDrawPage: (hookData: any) => {
            const pageCount = doc.internal.pages.length - 1;
            doc.setFontSize(7);
            doc.setFont('helvetica', 'normal');
            doc.setTextColor(148, 163, 184);    // slate-400

            // Left footer
            doc.text('Bhavya Computer Classes — Confidential', margin, pageH - 6);
            // Right footer: page number
            doc.text(
              `Page ${hookData.pageNumber} of ${pageCount}`,
              pageW - margin,
              pageH - 6,
              { align: 'right' }
            );

            // Footer line
            doc.setDrawColor(226, 232, 240);
            doc.setLineWidth(0.3);
            doc.line(margin, pageH - 10, pageW - margin, pageH - 10);
          },
        });

        // Save the PDF
        const filename = `attendance_report_${now.toISOString().split('T')[0]}.pdf`;
        doc.save(filename);

        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('PDF report downloaded successfully!', 'success');
        }
      } catch (err) {
        console.error('PDF generation failed:', err);
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast('Failed to generate PDF. Please try again.', 'error');
        }
      } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      }
    }

    // Expose to window so the inline onclick can call it
    (window as any).downloadPDF = downloadPDF;

    // ─── Filter handling ─────────────────────────────────────────────────────────
    const searchInput = document.getElementById('reports-search-input') as HTMLInputElement;
    const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;

    function applyFilters() {
      const query = searchInput.value.toLowerCase();
      const status = statusFilter.value;

      const filtered = allReports.filter((r) => {
        const matchesQuery = r.studentName.toLowerCase().includes(query) ||
          (r.studentNumber && r.studentNumber.toLowerCase().includes(query)) ||
          (r.className && r.className.toLowerCase().includes(query)) ||
          (r.subjectName && r.subjectName.toLowerCase().includes(query));

        const matchesStatus = status === 'all' || r.status === status;

        return matchesQuery && matchesStatus;
      });

      renderReports(filtered);
    }

    searchInput?.addEventListener('input', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);

    loadReports();
  </script>
</AdminLayout>

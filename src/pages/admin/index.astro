---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  GraduationCap,
  UserCheck,
  UserX,
  TrendingUp,
  Download,
  Plus,
  Search,
  ShieldCheck,
  Sparkles,
  Users,
} from 'lucide-astro';


const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="System Administration - Bhavya Computer Classes">
  <div class="space-y-8">
    
    <!-- Top Bar Header -->
    <div class="flex items-center justify-between flex-wrap gap-4 border-b border-slate-800 pb-5">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Admin Command Center</h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-500/20 text-brand-300 border border-brand-500/30">
            Full Access
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Institution Attendance, Faculty & Student Records</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/api/admin/reports?format=csv"
          onclick="showToast('Exporting comprehensive attendance report...', 'success')"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-600/30 transition active:scale-95"
        >
          <Download class="w-4 h-4" />
          <span>Export CSV Report</span>
        </a>
      </div>
    </div>

    <!-- Overview Metrics Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 rounded-3xl bg-slate-950/80 border border-white/10 shadow-glass-dark space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Students</span>
          <div class="p-2 rounded-2xl bg-brand-500/20 text-brand-400">
            <GraduationCap class="w-4 h-4" />
          </div>
        </div>
        <div>
          <span id="metric-students" class="block text-3xl font-black text-white">1,240</span>
          <div class="flex items-center gap-1 text-[11px] text-emerald-400 font-bold mt-1">
            <TrendingUp class="w-3 h-3" />
            <span>+12 this semester</span>
          </div>
        </div>
      </div>

      <div class="p-5 rounded-3xl bg-slate-950/80 border border-white/10 shadow-glass-dark space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Present Today</span>
          <div class="p-2 rounded-2xl bg-emerald-500/20 text-emerald-400">
            <UserCheck class="w-4 h-4" />
          </div>
        </div>
        <div>
          <span id="metric-present" class="block text-3xl font-black text-emerald-400">1,102</span>
          <span class="text-[11px] text-slate-400 font-medium">88.8% on-time attendance</span>
        </div>
      </div>

      <div class="p-5 rounded-3xl bg-slate-950/80 border border-white/10 shadow-glass-dark space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Absences Today</span>
          <div class="p-2 rounded-2xl bg-rose-500/20 text-rose-400">
            <UserX class="w-4 h-4" />
          </div>
        </div>
        <div>
          <span id="metric-absent" class="block text-3xl font-black text-rose-400">108</span>
          <span class="text-[11px] text-slate-400 font-medium">Unexcused / pending review</span>
        </div>
      </div>

      <div class="p-5 rounded-3xl bg-slate-950/80 border border-white/10 shadow-glass-dark space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Institution Avg</span>
          <div class="p-2 rounded-2xl bg-indigo-500/20 text-indigo-400">
            <Sparkles class="w-4 h-4" />
          </div>
        </div>
        <div>
          <span id="metric-avg" class="block text-3xl font-black text-brand-400">89.4%</span>
          <span class="text-[11px] text-emerald-400 font-bold">Above 75% required target</span>
        </div>
      </div>
    </div>

    <!-- Student Management Section -->
    <div id="students" class="bg-slate-950/80 rounded-3xl p-6 border border-white/10 shadow-glass-dark space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-black text-white flex items-center gap-2">
            <GraduationCap class="w-5 h-5 text-brand-400" />
            <span>Student Directory</span>
          </h3>
          <p class="text-xs text-slate-400">Manage enrolled student profiles and assignments</p>
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto">
          <div class="relative flex-1 sm:w-56">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
              <Search class="w-3.5 h-3.5" />
            </div>
            <input
              type="text"
              id="student-search-input"
              placeholder="Search students..."
              class="w-full pl-8 pr-3 py-2 rounded-xl bg-slate-900 border border-white/10 text-white placeholder-slate-500 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 transition font-medium"
            />
          </div>
          <button
            id="add-student-btn"
            class="inline-flex items-center gap-1.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow transition active:scale-95 whitespace-nowrap"
          >
            <Plus class="w-4 h-4" />
            <span>Add Student</span>
          </button>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900 text-slate-400 uppercase font-bold tracking-wider border-b border-white/10">
            <tr>
              <th class="p-3.5">Student Name</th>
              <th class="p-3.5">Student ID</th>
              <th class="p-3.5">Email Address</th>
              <th class="p-3.5">Batch / Class</th>
              <th class="p-3.5">Status</th>
            </tr>
          </thead>
          <tbody id="student-table-body" class="divide-y divide-white/5 font-medium">
            <tr>
              <td class="p-3.5 font-bold text-white">Rahul Kumar</td>
              <td class="p-3.5 text-slate-300 font-mono">BCA202601</td>
              <td class="p-3.5 text-slate-400">student1@bhavyacomputerclasses.com</td>
              <td class="p-3.5 font-bold text-brand-400">BCA 2A</td>
              <td class="p-3.5"><span class="badge-present">Active</span></td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-white">Aman Sharma</td>
              <td class="p-3.5 text-slate-300 font-mono">BCA202602</td>
              <td class="p-3.5 text-slate-400">student2@bhavyacomputerclasses.com</td>
              <td class="p-3.5 font-bold text-brand-400">BCA 2A</td>
              <td class="p-3.5"><span class="badge-present">Active</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Teacher Management Section -->
    <div id="teachers" class="bg-slate-950/80 rounded-3xl p-6 border border-white/10 shadow-glass-dark space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-black text-white flex items-center gap-2">
            <Users class="w-5 h-5 text-emerald-400" />
            <span>Faculty & Instructors</span>
          </h3>
          <p class="text-xs text-slate-400">Manage teaching staff credentials and assigned curriculum</p>
        </div>

        <button
          id="add-teacher-btn"
          class="inline-flex items-center gap-1.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl shadow transition active:scale-95"
        >
          <Plus class="w-4 h-4" />
          <span>Add Faculty</span>
        </button>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900 text-slate-400 uppercase font-bold tracking-wider border-b border-white/10">
            <tr>
              <th class="p-3.5">Faculty Name</th>
              <th class="p-3.5">Email Address</th>
              <th class="p-3.5">Assigned Modules</th>
              <th class="p-3.5">Status</th>
            </tr>
          </thead>
          <tbody id="teacher-table-body" class="divide-y divide-white/5 font-medium">
            <tr>
              <td class="p-3.5 font-bold text-white">Mr. Sharma</td>
              <td class="p-3.5 text-slate-400">teacher@bhavyacomputerclasses.com</td>
              <td class="p-3.5 text-slate-300">BCA 2A (Web Dev, Python, DB)</td>
              <td class="p-3.5"><span class="badge-present">Active Faculty</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- System Audit Logs Section -->
    <div id="audit" class="bg-slate-950/80 rounded-3xl p-6 border border-white/10 shadow-glass-dark space-y-4">
      <div>
        <h3 class="text-lg font-black text-white flex items-center gap-2">
          <ShieldCheck class="w-5 h-5 text-amber-400" />
          <span>Security & System Audit Trail</span>
        </h3>
        <p class="text-xs text-slate-400">Chronological ledger of authentication and session events</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/5">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900 text-slate-400 uppercase font-bold tracking-wider border-b border-white/10">
            <tr>
              <th class="p-3.5">Timestamp</th>
              <th class="p-3.5">User</th>
              <th class="p-3.5">Action Code</th>
              <th class="p-3.5">Details</th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-white/5 font-medium">
            <tr>
              <td class="p-3.5 text-slate-400 font-mono">Just now</td>
              <td class="p-3.5 font-bold text-white">System Admin</td>
              <td class="p-3.5 font-bold text-brand-400 font-mono">SYSTEM_ONLINE</td>
              <td class="p-3.5 text-slate-300">Attendance portal verified with Tailwind UI design</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Add Student Modal -->
  <div id="student-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-white/10 rounded-3xl p-6 max-w-md w-full text-white space-y-4 shadow-2xl relative">
      <button id="close-student-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white font-bold p-1">✕</button>
      <h3 class="text-lg font-bold">Enroll New Student</h3>
      
      <form id="add-student-form" class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-300 font-semibold mb-1">Full Name</label>
          <input type="text" id="new-std-name" required placeholder="e.g. Vikram Singh" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-slate-300 font-semibold mb-1">Student Number / ID</label>
          <input type="text" id="new-std-no" required placeholder="e.g. BCA202610" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-slate-300 font-semibold mb-1">Email Address</label>
          <input type="email" id="new-std-email" required placeholder="vikram@bhavyacomputerclasses.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-slate-300 font-semibold mb-1">Batch</label>
          <input type="text" id="new-std-class" required value="BCA 2A" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>

        <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold transition mt-2">
          Add Student to Directory
        </button>
      </form>
    </div>
  </div>

  <script>
    let allStudents: any[] = [];

    // Load admin metrics & tables
    async function loadAdminData() {
      try {
        const [stdRes, tchRes, auditRes] = await Promise.all([
          fetch('/api/admin/students'),
          fetch('/api/admin/teachers'),
          fetch('/api/admin/audit')
        ]);

        if (stdRes.ok) {
          const { students } = await stdRes.json();
          allStudents = students || [];
          renderStudentTable(allStudents);
        }

        if (tchRes.ok) {
          const { teachers } = await tchRes.json();
          const tbody = document.getElementById('teacher-table-body')!;
          if (teachers && teachers.length > 0) {
            tbody.innerHTML = teachers.map((t: any) => `
              <tr>
                <td class="p-3.5 font-bold text-white">${t.name}</td>
                <td class="p-3.5 text-slate-400">${t.email}</td>
                <td class="p-3.5 text-slate-300 font-medium">BCA 2A (Web Dev, Data Science)</td>
                <td class="p-3.5"><span class="badge-present">Active Faculty</span></td>
              </tr>
            `).join('');
          }
        }

        if (auditRes.ok) {
          const { logs } = await auditRes.json();
          const tbody = document.getElementById('audit-table-body')!;
          if (logs && logs.length > 0) {
            tbody.innerHTML = logs.map((l: any) => `
              <tr>
                <td class="p-3.5 text-slate-400 font-mono">${new Date(l.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</td>
                <td class="p-3.5 font-bold text-white">${l.userName || 'System'}</td>
                <td class="p-3.5 font-bold text-brand-400 font-mono">${l.action}</td>
                <td class="p-3.5 text-slate-300">${l.details || ''}</td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error('Admin data load failed:', err);
      }
    }

    function renderStudentTable(students: any[]) {
      const tbody = document.getElementById('student-table-body')!;
      if (students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-500">No students found.</td></tr>';
        return;
      }

      tbody.innerHTML = students.map((s: any) => `
        <tr>
          <td class="p-3.5 font-bold text-white">${s.name}</td>
          <td class="p-3.5 text-slate-300 font-mono">${s.studentNumber}</td>
          <td class="p-3.5 text-slate-400">${s.email}</td>
          <td class="p-3.5 font-bold text-brand-400">${s.className || 'BCA 2A'}</td>
          <td class="p-3.5"><span class="badge-present">${s.status || 'Active'}</span></td>
        </tr>
      `).join('');
    }

    // Search filter
    document.getElementById('student-search-input')?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      const filtered = allStudents.filter(s => s.name.toLowerCase().includes(q) || s.studentNumber?.toLowerCase().includes(q) || s.email?.toLowerCase().includes(q));
      renderStudentTable(filtered);
    });

    // Student modal controls
    const studentModal = document.getElementById('student-modal')!;
    document.getElementById('add-student-btn')?.addEventListener('click', () => {
      studentModal.classList.remove('hidden');
    });
    document.getElementById('close-student-modal')?.addEventListener('click', () => {
      studentModal.classList.add('hidden');
    });

    // Form submit
    document.getElementById('add-student-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('new-std-name') as HTMLInputElement).value;
      const studentNumber = (document.getElementById('new-std-no') as HTMLInputElement).value;
      const email = (document.getElementById('new-std-email') as HTMLInputElement).value;
      const className = (document.getElementById('new-std-class') as HTMLInputElement).value;

      allStudents.unshift({ name, studentNumber, email, className, status: 'Active' });
      renderStudentTable(allStudents);
      studentModal.classList.add('hidden');
      (window as any).showToast?.(`Added ${name} to directory!`, 'success');
    });

    // Add faculty trigger
    document.getElementById('add-teacher-btn')?.addEventListener('click', () => {
      const name = prompt('Enter Faculty Name:');
      if (name) {
        (window as any).showToast?.(`Faculty account for ${name} initialized!`, 'success');
      }
    });

    loadAdminData();
  </script>
</AdminLayout>


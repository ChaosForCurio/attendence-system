---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { BookOpen, Plus, Search, Layers, UserCheck } from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="Assign Courses - Bhavya Computer Classes">
  <div class="space-y-6">
    
    <!-- Top Bar Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Assign Courses &amp; Curriculum</h1>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-brand-50 text-brand-700 border border-brand-200/80">
            Academic Mapping
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">Assign subjects to classes and allocate teaching faculty members</p>
      </div>

      <button
        id="open-assign-modal"
        class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md shadow-brand-600/20 transition active:scale-95 whitespace-nowrap cursor-pointer"
      >
        <Plus class="w-4 h-4" />
        <span>Assign New Course</span>
      </button>
    </div>

    <!-- Overview Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Active Course Mappings</span>
          <span id="stat-total-mappings" class="text-2xl font-black text-slate-900">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-brand-50 text-brand-600">
          <BookOpen class="w-5 h-5" />
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Active Batches</span>
          <span id="stat-active-classes" class="text-2xl font-black text-emerald-600">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-emerald-50 text-emerald-600">
          <Layers class="w-5 h-5" />
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200/80 flex items-center justify-between shadow-sm">
        <div>
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block">Assigned Instructors</span>
          <span id="stat-instructors" class="text-2xl font-black text-indigo-600">0</span>
        </div>
        <div class="p-2.5 rounded-xl bg-indigo-50 text-indigo-600">
          <UserCheck class="w-5 h-5" />
        </div>
      </div>
    </div>

    <!-- Controls & Course Assignments Table -->
    <div class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <Search class="w-4 h-4" />
          </div>
          <input
            type="text"
            id="course-search-input"
            placeholder="Search by class, subject name, or teacher..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 transition font-medium"
          />
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-100/80 text-slate-700 uppercase font-bold tracking-wider border-b border-slate-200">
            <tr>
              <th class="p-4">Batch / Class</th>
              <th class="p-4">Course / Subject</th>
              <th class="p-4">Subject Code</th>
              <th class="p-4">Assigned Instructor</th>
              <th class="p-4">Status</th>
            </tr>
          </thead>
          <tbody id="course-table-body" class="divide-y divide-slate-200/60 font-medium">
            <tr>
              <td colspan="5" class="p-6 text-center text-slate-400">Loading course assignments...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Assign Course Modal -->
  <div id="assign-modal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200/80 rounded-3xl p-6 max-w-md w-full text-slate-900 space-y-4 shadow-2xl relative">
      <button id="close-assign-modal" class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 font-bold p-1">✕</button>
      
      <div>
        <h3 class="text-lg font-bold">Assign Course to Class</h3>
        <p class="text-xs text-slate-500 font-medium">Link a subject to a batch and assign an instructor</p>
      </div>

      <form id="assign-course-form" class="space-y-3.5 text-xs">
        <div>
          <label class="block text-slate-700 font-semibold mb-1">Target Batch / Class</label>
          <select id="assign-class-id" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="" disabled selected>Loading classes...</option>
          </select>
        </div>

        <div>
          <label class="block text-slate-700 font-semibold mb-1">Subject / Course</label>
          <select id="assign-subject-id" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="" disabled selected>Loading subjects...</option>
          </select>
        </div>

        <div>
          <label class="block text-slate-700 font-semibold mb-1">Faculty Instructor</label>
          <select id="assign-teacher-id" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="" disabled selected>Loading instructors...</option>
          </select>
        </div>

        <button type="submit" id="submit-assign-btn" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-500 active:bg-brand-700 text-white font-bold transition mt-3 shadow-md shadow-brand-600/20 cursor-pointer">
          Assign Course
        </button>
      </form>
    </div>
  </div>

  <script>
    let allClassSubjects: any[] = [];

    async function loadData() {
      try {
        const [csRes, cRes, subRes, tRes] = await Promise.all([
          fetch('/api/admin/class-subjects'),
          fetch('/api/admin/classes'),
          fetch('/api/admin/subjects'),
          fetch('/api/admin/teachers')
        ]);

        if (csRes.ok) {
          const csData = await csRes.json();
          allClassSubjects = csData.classSubjects || [];
        }

        if (cRes.ok) {
          const { classes } = await cRes.json();
          populateSelect('assign-class-id', classes, (c: any) => ({ value: c.id, label: c.name }));
          document.getElementById('stat-active-classes')!.textContent = (classes ? classes.length : 0).toString();
        }

        if (subRes.ok) {
          const { subjects } = await subRes.json();
          populateSelect('assign-subject-id', subjects, (s: any) => ({ value: s.id, label: `${s.name} (${s.code})` }));
        }

        if (tRes.ok) {
          const { teachers } = await tRes.json();
          populateSelect('assign-teacher-id', teachers, (t: any) => ({ value: t.teacherId, label: t.name }));
          document.getElementById('stat-instructors')!.textContent = (teachers ? teachers.length : 0).toString();
        }

        document.getElementById('stat-total-mappings')!.textContent = allClassSubjects.length.toString();
        renderTable(allClassSubjects);
      } catch (err) {
        console.error('Failed to load course assignments:', err);
      }
    }

    function populateSelect(elemId: string, list: any[], mapFn: Function) {
      const el = document.getElementById(elemId) as HTMLSelectElement;
      if (!el || !list) return;
      el.innerHTML = '<option value="" disabled selected>— Select option —</option>';
      list.forEach((item: any) => {
        const { value, label } = mapFn(item);
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = label;
        el.appendChild(opt);
      });
    }

    function renderTable(list: any[]) {
      const tbody = document.getElementById('course-table-body')!;
      if (!list || list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-slate-500 font-medium">No course assignments found. Click "Assign New Course" to add one.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map((cs: any) => `
        <tr class="hover:bg-slate-50/80 transition text-slate-900">
          <td class="p-4 font-bold text-slate-900">${cs.className}</td>
          <td class="p-4 font-bold text-brand-600">${cs.subjectName}</td>
          <td class="p-4 text-slate-600 font-mono text-xs">${cs.subjectCode || 'CS101'}</td>
          <td class="p-4 text-slate-600 font-medium">${cs.teacherName}</td>
          <td class="p-4">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
              Active Mapping
            </span>
          </td>
        </tr>
      `).join('');
    }

    // Filter handling
    const searchInput = document.getElementById('course-search-input') as HTMLInputElement;
    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      const filtered = allClassSubjects.filter((cs) =>
        cs.className.toLowerCase().includes(query) ||
        cs.subjectName.toLowerCase().includes(query) ||
        (cs.teacherName && cs.teacherName.toLowerCase().includes(query))
      );
      renderTable(filtered);
    });

    // Modal controls
    const modal = document.getElementById('assign-modal')!;
    document.getElementById('open-assign-modal')?.addEventListener('click', () => modal.classList.remove('hidden'));
    document.getElementById('close-assign-modal')?.addEventListener('click', () => modal.classList.add('hidden'));

    // Submit handler
    document.getElementById('assign-course-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-assign-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Assigning...';

      const classId = (document.getElementById('assign-class-id') as HTMLSelectElement).value;
      const subjectId = (document.getElementById('assign-subject-id') as HTMLSelectElement).value;
      const teacherId = (document.getElementById('assign-teacher-id') as HTMLSelectElement).value;

      try {
        const res = await fetch('/api/admin/class-subjects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ classId, subjectId, teacherId }),
        });

        if (res.ok) {
          (window as any).showToast?.('Course assigned successfully!', 'success');
          modal.classList.add('hidden');
          loadData();
        } else {
          const data = await res.json();
          (window as any).showToast?.(data.error || 'Failed to assign course.', 'error');
        }
      } catch (err) {
        (window as any).showToast?.('Failed to submit assignment.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Assign Course';
      }
    });

    loadData();
  </script>
</AdminLayout>

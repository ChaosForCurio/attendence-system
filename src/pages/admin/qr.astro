---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { QrCode, RefreshCw, Maximize2, Minimize2, CheckCircle2, XCircle, ShieldCheck, Sparkles, Clock, Layers, ChevronDown } from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="Attendance Dynamic QR Control - Bhavya Computer Classes">
  <div class="max-w-4xl mx-auto space-y-8 pb-12">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-5">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Attendance QR Manager</h1>
          <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-brand-50 text-brand-700 border border-brand-200/80">
            Realtime QR Invalidation
          </span>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">Generate unique, secure session QR tokens per class. Old tokens terminate automatically upon regeneration.</p>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="toggle-fullscreen-top-btn"
          class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 active:bg-slate-100 text-slate-700 font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-200/80 transition active:scale-95 shadow-sm"
        >
          <Maximize2 class="w-4 h-4 text-brand-600" />
          <span>Fullscreen Mode</span>
        </button>
      </div>
    </div>

    <!-- CLASS / COURSE SELECTOR -->
    <div class="bg-white border border-slate-200/80 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-4 shadow-sm">
      <div class="flex items-center gap-2 text-brand-600">
        <Layers class="w-5 h-5" />
        <span class="text-sm font-bold text-slate-900">Select Class / Course</span>
      </div>
      <div class="relative flex-1 max-w-xs">
        <select
          id="class-selector"
          class="w-full px-4 py-2.5 pr-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500 appearance-none cursor-pointer"
        >
          <option value="" disabled selected>Loading classes...</option>
        </select>
        <ChevronDown class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" />
      </div>
      <p class="text-[11px] text-slate-500 font-medium">QR tokens are isolated per class. Regenerating one class does not affect others.</p>
    </div>

    <!-- MAIN ATTENDANCE QR DISPLAY CARD -->
    <div class="flex justify-center">
      <div
        id="qr-main-card"
        class="w-full max-w-md bg-white border-2 border-emerald-500/40 rounded-3xl p-6 sm:p-8 space-y-6 shadow-lg relative overflow-hidden text-center transition-all duration-300"
      >
        <!-- Top Card Title -->
        <div class="space-y-1">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 font-mono block">INSTITUTIONAL QR PORTAL</span>
          <h2 id="qr-card-class-name" class="text-xl font-black text-slate-900 tracking-wide uppercase border-b border-slate-200/80 pb-3">ATTENDANCE QR</h2>
        </div>

        <!-- Dynamic QR Display Container — real scannable PNG -->
        <div class="relative group my-2 flex justify-center">
          <div class="p-4 bg-white rounded-3xl border-4 border-slate-200 shadow-inner flex items-center justify-center w-64 h-64 relative">
            <!-- Real QR image rendered by API -->
            <img
              id="qr-image"
              src=""
              alt="Attendance QR Code"
              class="w-52 h-52 object-contain"
              style="display:none;"
            />
            <!-- Placeholder while loading -->
            <div id="qr-placeholder" class="flex flex-col items-center justify-center w-52 h-52 text-slate-300 gap-2">
              <QrCode class="w-16 h-16 text-slate-300" />
              <span class="text-xs text-slate-400 font-medium">Select a class &amp; generate QR</span>
            </div>
            <div id="qr-loading" class="absolute inset-0 bg-white/90 rounded-3xl flex items-center justify-center hidden">
              <RefreshCw class="w-8 h-8 text-brand-600 animate-spin" />
            </div>
          </div>
        </div>

        <!-- Scan URL hint -->
        <div id="scan-url-display" class="hidden text-[11px] font-mono text-brand-600 truncate px-1 font-semibold">
          Scan URL: <span id="scan-url-text"></span>
        </div>

        <!-- Session Meta Details -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4 space-y-2 text-xs font-mono">
          <div class="flex items-center justify-between text-slate-700">
            <span class="text-slate-500 font-sans font-semibold">Session:</span>
            <span id="qr-session-code" class="font-bold text-brand-600 text-sm">#ATT-2026-091</span>
          </div>

          <div class="flex items-center justify-between text-slate-700">
            <span class="text-slate-500 font-sans font-semibold">Generated:</span>
            <span id="qr-generated-time" class="font-bold text-slate-900">--:-- --</span>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-200">
            <span class="text-slate-500 font-sans font-semibold">Status:</span>
            <div id="qr-status-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-200/70 text-slate-600 border border-slate-300/60">
              <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
              <span>NOT ACTIVE</span>
            </div>
          </div>
        </div>

        <!-- Primary Action Button: GENERATE NEW QR -->
        <button
          id="generate-new-qr-btn"
          class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 active:from-brand-700 active:to-indigo-700 text-white font-extrabold text-sm transition shadow-lg shadow-brand-600/25 flex items-center justify-center gap-2.5 active:scale-95 group disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          disabled
        >
          <RefreshCw class="w-5 h-5 group-hover:rotate-180 transition-transform duration-500" />
          <span>GENERATE NEW QR</span>
        </button>

        <p class="text-[11px] text-slate-500 font-medium italic">
          Clicking generates a new unique QR code for the selected class. The previous QR code will immediately terminate.
        </p>

      </div>
    </div>

    <!-- LIFECYCLE AUDIT STATUS PANEL -->
    <div class="bg-white border border-slate-200/80 rounded-3xl p-6 space-y-4 shadow-sm">
      <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
        <Layers class="w-4 h-4 text-brand-600" />
        <span>QR Token Lifecycle &amp; Invalidation Status</span>
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
        <!-- Old QR Termination Card -->
        <div class="p-4 rounded-2xl bg-rose-50/60 border border-rose-200 space-y-2">
          <div class="flex items-center justify-between text-rose-700 font-bold font-sans">
            <span class="flex items-center gap-1.5">
              <XCircle class="w-4 h-4" />
              OLD QR TOKEN
            </span>
            <span class="px-2 py-0.5 rounded bg-rose-100 border border-rose-300 text-[10px] font-extrabold">❌ TERMINATED</span>
          </div>
          <p id="old-token-display" class="text-rose-900 text-[11px] truncate font-medium">
            Previous token: None terminated yet in this session
          </p>
          <p class="text-[10px] text-rose-700/90 font-sans">
            Any student scanning this old QR code will receive an error: <strong class="text-rose-900">"QR Code Terminated"</strong>.
          </p>
        </div>

        <!-- New QR Active Card -->
        <div class="p-4 rounded-2xl bg-emerald-50/60 border border-emerald-200 space-y-2">
          <div class="flex items-center justify-between text-emerald-700 font-bold font-sans">
            <span class="flex items-center gap-1.5">
              <CheckCircle2 class="w-4 h-4" />
              NEW QR TOKEN
            </span>
            <span class="px-2 py-0.5 rounded bg-emerald-100 border border-emerald-300 text-[10px] font-extrabold">🟢 ACTIVE</span>
          </div>
          <p id="new-token-display" class="text-emerald-900 text-[11px] truncate font-bold">
            Token: Generate a QR above to activate
          </p>
          <p class="text-[10px] text-emerald-700/90 font-sans">
            Only scans matching this active token will authenticate and mark student attendance.
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- FULLSCREEN MODAL OVERLAY FOR CLASSROOM PROJECTOR -->
  <div id="fullscreen-overlay" class="fixed inset-0 bg-slate-900 z-50 hidden flex flex-col items-center justify-center p-6 space-y-6 select-none">
    <button
      id="exit-fullscreen-btn"
      class="absolute top-6 right-6 inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold text-xs px-4 py-2 rounded-xl transition"
    >
      <Minimize2 class="w-4 h-4 text-rose-400" />
      <span>Exit Fullscreen</span>
    </button>

    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/40 text-xs font-bold uppercase tracking-widest">
        <Sparkles class="w-4 h-4 text-brand-400" />
        <span>Bhavya Computer Classes • Live Classroom Display</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">SCAN FOR ATTENDANCE</h1>
      <p id="fullscreen-class-label" class="text-sm text-slate-400">Open your mobile camera or browser scanner to mark your present status</p>
    </div>

    <!-- Huge Projector QR Display — real scannable PNG -->
    <div class="p-8 bg-white rounded-3xl border-8 border-slate-800 shadow-2xl flex items-center justify-center w-80 h-80 sm:w-96 sm:h-96">
      <img
        id="fullscreen-qr-img"
        src=""
        alt="Scan for Attendance"
        class="w-full h-full object-contain"
        style="display:none;"
      />
      <div id="fullscreen-qr-placeholder" class="flex flex-col items-center text-slate-400 gap-2">
        <QrCode class="w-20 h-20 text-slate-300" />
        <span class="text-xs">Generate QR first</span>
      </div>
    </div>

    <div class="flex items-center gap-6 font-mono text-sm bg-slate-900 border border-slate-800 px-6 py-3 rounded-2xl">
      <div class="flex items-center gap-2">
        <span class="text-slate-400">Session:</span>
        <span id="fullscreen-session" class="font-bold text-brand-400">#ATT-2026-091</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-slate-400">Time:</span>
        <span id="fullscreen-time" class="font-bold text-white">--:-- --</span>
      </div>
      <div id="fullscreen-status-badge" class="flex items-center gap-2 text-slate-400 font-bold">
        <span class="w-3 h-3 rounded-full bg-slate-400"></span>
        <span>NOT ACTIVE</span>
      </div>
    </div>

    <button
      id="fullscreen-gen-btn"
      class="px-8 py-4 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white font-black text-base shadow-2xl transition active:scale-95 flex items-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
      disabled
    >
      <RefreshCw class="w-5 h-5" />
      <span>GENERATE NEW QR CODE</span>
    </button>
  </div>

  <script>
    let activeToken = '';
    let previousToken = '';
    let selectedClassId = '';
    let selectedClassName = 'All Classes';

    // ── Load classes into the dropdown ────────────────────────────────────
    async function loadClasses() {
      try {
        const res = await fetch('/api/admin/classes');
        if (!res.ok) throw new Error('Failed');
        const { classes } = await res.json();

        const select = document.getElementById('class-selector') as HTMLSelectElement;
        select.innerHTML = '<option value="" disabled>— Select a Class —</option>';

        if (classes && classes.length > 0) {
          classes.forEach((c: any) => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name;
            select.appendChild(opt);
          });
          // Auto-select first class
          select.value = classes[0].id;
          selectedClassId = classes[0].id;
          selectedClassName = classes[0].name;
          onClassSelected();
        } else {
          // Fallback static classes if DB has none yet
          select.innerHTML = '<option value="cls_bca_2a">BCA 2A</option><option value="cls_pgdca">PGDCA</option>';
          select.value = 'cls_bca_2a';
          selectedClassId = 'cls_bca_2a';
          selectedClassName = 'BCA 2A';
          onClassSelected();
        }
      } catch (err) {
        console.error('Failed to load classes:', err);
        const select = document.getElementById('class-selector') as HTMLSelectElement;
        select.innerHTML = '<option value="cls_bca_2a">BCA 2A</option><option value="cls_pgdca">PGDCA</option>';
        select.value = 'cls_bca_2a';
        selectedClassId = 'cls_bca_2a';
        selectedClassName = 'BCA 2A';
        onClassSelected();
      }
    }

    function onClassSelected() {
      // Enable buttons
      const genBtn = document.getElementById('generate-new-qr-btn') as HTMLButtonElement;
      const fsBtn = document.getElementById('fullscreen-gen-btn') as HTMLButtonElement;
      genBtn.disabled = false;
      fsBtn.disabled = false;

      // Update labels
      document.getElementById('qr-card-class-name')!.textContent = `${selectedClassName} — ATTENDANCE QR`;
      document.getElementById('fullscreen-class-label')!.textContent = `${selectedClassName} — Scan with your phone camera to mark attendance`;

      // Load existing QR state for this class (if any)
      loadCurrentQrState();
    }

    // ── Fetch Active QR state ─────────────────────────────────────────────
    async function loadCurrentQrState() {
      if (!selectedClassId) return;
      try {
        const res = await fetch(`/api/admin/qr?classId=${encodeURIComponent(selectedClassId)}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.token) {
          activeToken = data.token;
          updateUI(data);
        }
      } catch (err) {
        console.error('Error fetching QR state:', err);
      }
    }

    // ── Generate New QR code ──────────────────────────────────────────────
    async function generateNewQr() {
      if (!selectedClassId) {
        (window as any).showToast?.('Please select a class first.', 'error');
        return;
      }

      const loader = document.getElementById('qr-loading');
      if (loader) loader.classList.remove('hidden');

      try {
        const sessionCode = `#ATT-${selectedClassName.replace(/\s+/g, '').toUpperCase().substring(0, 6)}-${new Date().getFullYear()}`;

        const res = await fetch('/api/admin/qr', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ classId: selectedClassId, sessionCode }),
        });

        const data = await res.json();
        if (loader) loader.classList.add('hidden');

        if (res.ok && data.token) {
          previousToken = activeToken;
          activeToken = data.token;
          updateUI(data);
          (window as any).showToast?.(`QR for ${selectedClassName} generated! Previous QR terminated.`, 'success', 3500);
        }
      } catch (err) {
        if (loader) loader.classList.add('hidden');
        (window as any).showToast?.('Failed to generate new QR token.', 'error');
      }
    }

    function updateUI(data: any) {
      const timeStr = data.formattedTime || new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
      const codeStr = data.sessionCode || '#ATT-2026-091';
      const qrDataUrl: string = data.qrDataUrl || '';
      const scanUrl: string = data.scanUrl || '';

      // Update text labels
      document.getElementById('qr-session-code')!.textContent = codeStr;
      document.getElementById('qr-generated-time')!.textContent = timeStr;
      document.getElementById('fullscreen-session')!.textContent = codeStr;
      document.getElementById('fullscreen-time')!.textContent = timeStr;

      // Status badge — ACTIVE
      const badge = document.getElementById('qr-status-badge')!;
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
      badge.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span><span>🟢 ACTIVE</span>';

      const fsBadge = document.getElementById('fullscreen-status-badge')!;
      fsBadge.className = 'flex items-center gap-2 text-emerald-400 font-bold';
      fsBadge.innerHTML = '<span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span><span>🟢 ACTIVE</span>';

      // ── Display real QR PNG ──
      if (qrDataUrl) {
        const qrImg = document.getElementById('qr-image') as HTMLImageElement;
        const qrPlaceholder = document.getElementById('qr-placeholder')!;
        qrImg.src = qrDataUrl;
        qrImg.style.display = 'block';
        qrPlaceholder.style.display = 'none';

        const fsImg = document.getElementById('fullscreen-qr-img') as HTMLImageElement;
        const fsPlaceholder = document.getElementById('fullscreen-qr-placeholder')!;
        fsImg.src = qrDataUrl;
        fsImg.style.display = 'block';
        fsPlaceholder.style.display = 'none';
      }

      // Show scan URL hint
      if (scanUrl) {
        document.getElementById('scan-url-display')!.classList.remove('hidden');
        document.getElementById('scan-url-text')!.textContent = scanUrl;
      }

      // Update token audit cards
      if (previousToken) {
        document.getElementById('old-token-display')!.textContent = `Terminated Token: ${previousToken.substring(0, 40)}...`;
      }
      document.getElementById('new-token-display')!.textContent = `Active Token: ${activeToken.substring(0, 40)}...`;
    }

    // ── Event Listeners ───────────────────────────────────────────────────
    document.getElementById('class-selector')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      selectedClassId = select.value;
      selectedClassName = select.options[select.selectedIndex].text;
      // Reset QR display
      activeToken = '';
      previousToken = '';
      const qrImg = document.getElementById('qr-image') as HTMLImageElement;
      qrImg.src = '';
      qrImg.style.display = 'none';
      document.getElementById('qr-placeholder')!.style.display = 'flex';
      document.getElementById('scan-url-display')!.classList.add('hidden');
      const badge = document.getElementById('qr-status-badge')!;
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-700/50 text-slate-400 border border-slate-600/40';
      badge.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span><span>NOT ACTIVE</span>';
      onClassSelected();
    });

    document.getElementById('generate-new-qr-btn')?.addEventListener('click', generateNewQr);
    document.getElementById('fullscreen-gen-btn')?.addEventListener('click', generateNewQr);

    // Fullscreen Overlay Toggle
    const fsOverlay = document.getElementById('fullscreen-overlay')!;
    document.getElementById('toggle-fullscreen-top-btn')?.addEventListener('click', () => {
      fsOverlay.classList.remove('hidden');
    });
    document.getElementById('exit-fullscreen-btn')?.addEventListener('click', () => {
      fsOverlay.classList.add('hidden');
    });

    // Initial load
    loadClasses();
  </script>
</AdminLayout>

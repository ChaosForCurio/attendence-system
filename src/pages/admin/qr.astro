---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  QrCode,
  RefreshCw,
  Minimize2,
  Sparkles,
  Layers,
  ChevronDown,
  Clock3,
} from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'admin') {
  return Astro.redirect('/login');
}
---

<AdminLayout title="Attendance QR Manager - BCI">
  <div class="max-w-6xl mx-auto space-y-6 pb-12">
    
    <!-- Top Header & Actions -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div>
        <div class="flex items-center gap-2.5 flex-wrap">
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Attendance QR Manager</h1>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">
          Generate secure dynamic attendance QR codes per batch with immediate auto-invalidation of prior tokens.
        </p>
      </div>
    </div>

    <!-- Quick Control Bar: Class Selector -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      <div class="flex items-center gap-3 flex-1 min-w-0">
        <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
          <Layers class="w-5 h-5" />
        </div>
        <div class="flex-1 min-w-0">
          <label for="class-selector" class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">
            Target Batch / Course
          </label>
          <div class="relative max-w-sm">
            <select
              id="class-selector"
              class="w-full px-3.5 py-2 pr-9 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-brand-500 appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Loading batches...</option>
            </select>
            <ChevronDown class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>
        </div>
      </div>
    </div>

    <!-- 2-COLUMN WORKSPACE: LEFT (QR CARD) & RIGHT (DETAILS & LIFECYCLE) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT COLUMN: Main QR Stage Card (5 cols on lg) -->
      <div class="lg:col-span-5 flex justify-center">
        <div
          id="qr-main-card"
          class="w-full bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-7 space-y-5 shadow-sm text-center relative overflow-hidden"
        >
          <!-- Card Header & Badge -->
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="text-left">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 font-mono block">Classroom QR</span>
              <h2 id="qr-card-class-name" class="text-base font-black text-slate-900 truncate max-w-[220px]">SELECT BATCH</h2>
            </div>
            <div id="qr-status-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black bg-slate-100 text-slate-600 border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span>
              <span>STANDBY</span>
            </div>
          </div>

          <!-- The QR Frame -->
          <div class="relative my-2 flex justify-center">
            <div class="p-3.5 bg-gradient-to-b from-slate-50 to-white rounded-3xl border-2 border-dashed border-slate-200 shadow-inner flex items-center justify-center w-64 h-64 relative group">
              <!-- Real QR image -->
              <img
                id="qr-image"
                src=""
                alt="Attendance QR Code"
                class="w-56 h-56 object-contain rounded-xl transition duration-300 group-hover:scale-102"
                style="display:none;"
              />
              <!-- Placeholder -->
              <div id="qr-placeholder" class="flex flex-col items-center justify-center w-56 h-56 text-slate-400 gap-2.5">
                <div class="p-4 rounded-2xl bg-slate-100 text-slate-400">
                  <QrCode class="w-12 h-12" />
                </div>
                <span class="text-xs font-semibold text-slate-500">Pick a batch to view or generate QR</span>
              </div>
              <!-- Loading Spinner -->
              <div id="qr-loading" class="absolute inset-0 bg-white/95 backdrop-blur-sm rounded-3xl flex flex-col items-center justify-center gap-2 hidden z-10">
                <RefreshCw class="w-8 h-8 text-brand-600 animate-spin" />
                <span class="text-xs font-bold text-slate-700">Regenerating Token...</span>
              </div>
            </div>
          </div>


          <!-- Generate Action -->
          <div class="space-y-2 pt-1">
            <button
              id="generate-new-qr-btn"
              class="w-full py-3.5 px-5 rounded-2xl bg-brand-600 hover:bg-brand-700 active:bg-brand-800 text-white font-extrabold text-xs transition shadow-md shadow-brand-600/25 flex items-center justify-center gap-2 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              disabled
            >
              <RefreshCw class="w-4 h-4 transition-transform group-hover:rotate-180" />
              <span>GENERATE NEW QR CODE</span>
            </button>
            <p class="text-[11px] text-slate-400 font-medium leading-relaxed">
              Generating immediately invalidates all previous QR codes for this batch.
            </p>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: Session Details (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-5">
        
        <!-- Live Session Information Card -->
        <div class="bg-white border border-slate-200/90 rounded-3xl p-5 sm:p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <Clock3 class="w-4 h-4 text-brand-600" />
              <span>Current Session Details</span>
            </h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Session ID</span>
              <span id="qr-session-code" class="font-bold text-brand-600 font-mono text-sm block">--</span>
            </div>

            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/70 space-y-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Last Generated</span>
              <span id="qr-generated-time" class="font-bold text-slate-900 font-mono text-sm block">--:-- --</span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- FULLSCREEN MODAL OVERLAY FOR CLASSROOM PROJECTOR -->
  <div id="fullscreen-overlay" class="fixed inset-0 bg-slate-950/95 backdrop-blur-md z-50 hidden flex flex-col items-center justify-center p-6 space-y-6 select-none">
    <button
      id="exit-fullscreen-btn"
      class="absolute top-6 right-6 inline-flex items-center gap-2 bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition cursor-pointer"
    >
      <Minimize2 class="w-4 h-4 text-rose-400" />
      <span>Exit Fullscreen</span>
    </button>

    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30 text-xs font-bold uppercase tracking-wider">
        <Sparkles class="w-3.5 h-3.5 text-brand-400" />
        <span>BCI • Live Classroom Projector</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">SCAN FOR ATTENDANCE</h1>
      <p id="fullscreen-class-label" class="text-sm text-slate-400 font-medium max-w-md mx-auto">
        Point your phone camera to register your attendance
      </p>
    </div>

    <!-- Huge Projector QR Display -->
    <div class="p-6 sm:p-8 bg-white rounded-3xl border-4 border-slate-700 shadow-2xl flex items-center justify-center w-72 h-72 sm:w-96 sm:h-96">
      <img
        id="fullscreen-qr-img"
        src=""
        alt="Scan for Attendance"
        class="w-full h-full object-contain"
        style="display:none;"
      />
      <div id="fullscreen-qr-placeholder" class="flex flex-col items-center text-slate-400 gap-2">
        <QrCode class="w-16 h-16 text-slate-300" />
        <span class="text-xs font-semibold">Generate QR first</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 font-mono text-xs sm:text-sm bg-slate-900 border border-slate-800 px-6 py-3 rounded-2xl">
      <div class="flex items-center gap-2">
        <span class="text-slate-400">Session:</span>
        <span id="fullscreen-session" class="font-bold text-brand-400">--</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-slate-400">Time:</span>
        <span id="fullscreen-time" class="font-bold text-white">--:-- --</span>
      </div>
      <div id="fullscreen-status-badge" class="flex items-center gap-2 text-slate-400 font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
        <span>STANDBY</span>
      </div>
    </div>

    <button
      id="fullscreen-gen-btn"
      class="px-7 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-500 text-white font-extrabold text-sm shadow-xl transition active:scale-95 flex items-center gap-2.5 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
      disabled
    >
      <RefreshCw class="w-4 h-4" />
      <span>GENERATE NEW QR CODE</span>
    </button>
  </div>

  <script>
    let activeToken = '';
    let previousToken = '';
    let selectedClassId = '';
    let selectedClassName = 'All Classes';

    // ── Load classes into the dropdown ────────────────────────────────────
    async function loadClasses() {
      try {
        const res = await fetch('/api/admin/classes');
        if (!res.ok) throw new Error('Failed');
        const { classes } = await res.json();

        const select = document.getElementById('class-selector') as HTMLSelectElement;
        select.innerHTML = '<option value="" disabled>— Select a Class —</option>';

        if (classes && classes.length > 0) {
          classes.forEach((c: any) => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name;
            select.appendChild(opt);
          });
          // Auto-select first class
          select.value = classes[0].id;
          selectedClassId = classes[0].id;
          selectedClassName = classes[0].name;
          onClassSelected();
        } else {
          // Fallback static classes if DB has none yet
          select.innerHTML = '<option value="cls_bca_2a">BCA 2A</option><option value="cls_pgdca">PGDCA</option>';
          select.value = 'cls_bca_2a';
          selectedClassId = 'cls_bca_2a';
          selectedClassName = 'BCA 2A';
          onClassSelected();
        }
      } catch (err) {
        console.error('Failed to load classes:', err);
        const select = document.getElementById('class-selector') as HTMLSelectElement;
        select.innerHTML = '<option value="cls_bca_2a">BCA 2A</option><option value="cls_pgdca">PGDCA</option>';
        select.value = 'cls_bca_2a';
        selectedClassId = 'cls_bca_2a';
        selectedClassName = 'BCA 2A';
        onClassSelected();
      }
    }

    function onClassSelected() {
      // Enable buttons
      const genBtn = document.getElementById('generate-new-qr-btn') as HTMLButtonElement;
      const fsBtn = document.getElementById('fullscreen-gen-btn') as HTMLButtonElement;
      genBtn.disabled = false;
      fsBtn.disabled = false;

      // Update labels
      document.getElementById('qr-card-class-name')!.textContent = `${selectedClassName} — ATTENDANCE QR`;
      document.getElementById('fullscreen-class-label')!.textContent = `${selectedClassName} — Scan with your phone camera to mark attendance`;

      // Load existing QR state for this class (if any)
      loadCurrentQrState();
    }

    // ── Fetch Active QR state ─────────────────────────────────────────────
    async function loadCurrentQrState() {
      if (!selectedClassId) return;
      try {
        const res = await fetch(`/api/admin/qr?classId=${encodeURIComponent(selectedClassId)}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.token) {
          activeToken = data.token;
          updateUI(data);
        }
      } catch (err) {
        console.error('Error fetching QR state:', err);
      }
    }

    // ── Generate New QR code ──────────────────────────────────────────────
    async function generateNewQr() {
      if (!selectedClassId) {
        (window as any).showToast?.('Please select a class first.', 'error');
        return;
      }

      const loader = document.getElementById('qr-loading');
      if (loader) loader.classList.remove('hidden');

      try {
        const sessionCode = `#ATT-${selectedClassName.replace(/\s+/g, '').toUpperCase().substring(0, 6)}-${new Date().getFullYear()}`;

        const res = await fetch('/api/admin/qr', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ classId: selectedClassId, sessionCode }),
        });

        const data = await res.json();
        if (loader) loader.classList.add('hidden');

        if (res.ok && data.token) {
          previousToken = activeToken;
          activeToken = data.token;
          updateUI(data);
          (window as any).showToast?.(`QR for ${selectedClassName} generated! Previous QR terminated.`, 'success', 3500);
        }
      } catch (err) {
        if (loader) loader.classList.add('hidden');
        (window as any).showToast?.('Failed to generate new QR token.', 'error');
      }
    }

    function updateUI(data: any) {
      const timeStr = data.formattedTime || new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
      const codeStr = data.sessionCode || '#ATT-2026-091';
      const qrDataUrl: string = data.qrDataUrl || '';
      const scanUrl: string = data.scanUrl || '';

      // Update text labels
      document.getElementById('qr-session-code')!.textContent = codeStr;
      document.getElementById('qr-generated-time')!.textContent = timeStr;
      document.getElementById('fullscreen-session')!.textContent = codeStr;
      document.getElementById('fullscreen-time')!.textContent = timeStr;

      // Status badge — ACTIVE
      const badge = document.getElementById('qr-status-badge')!;
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300';
      badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span><span>ACTIVE</span>';


      const fsBadge = document.getElementById('fullscreen-status-badge')!;
      fsBadge.className = 'flex items-center gap-2 text-emerald-400 font-bold';
      fsBadge.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span><span>ACTIVE</span>';

      // ── Display real QR PNG ──
      if (qrDataUrl) {
        const qrImg = document.getElementById('qr-image') as HTMLImageElement;
        const qrPlaceholder = document.getElementById('qr-placeholder')!;
        qrImg.src = qrDataUrl;
        qrImg.style.display = 'block';
        qrPlaceholder.style.display = 'none';

        const fsImg = document.getElementById('fullscreen-qr-img') as HTMLImageElement;
        const fsPlaceholder = document.getElementById('fullscreen-qr-placeholder')!;
        fsImg.src = qrDataUrl;
        fsImg.style.display = 'block';
        fsPlaceholder.style.display = 'none';
      }

      // Show scan URL hint (if present)
      const scanUrlDisplay = document.getElementById('scan-url-display');
      if (scanUrlDisplay && scanUrl) {
        scanUrlDisplay.classList.remove('hidden');
        const scanUrlText = document.getElementById('scan-url-text');
        if (scanUrlText) scanUrlText.textContent = scanUrl;
        const openLink = document.getElementById('open-scan-url-link') as HTMLAnchorElement;
        if (openLink) openLink.href = scanUrl;
      }

      // Update token audit cards (if present)
      const oldTokenDisplay = document.getElementById('old-token-display');
      if (oldTokenDisplay && previousToken) {
        oldTokenDisplay.textContent = `Terminated: ${previousToken.substring(0, 32)}...`;
      }
      const newTokenDisplay = document.getElementById('new-token-display');
      if (newTokenDisplay) {
        newTokenDisplay.textContent = `Active: ${activeToken.substring(0, 32)}...`;
      }
    }

    // ── Event Listeners ───────────────────────────────────────────────────
    document.getElementById('class-selector')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      selectedClassId = select.value;
      selectedClassName = select.options[select.selectedIndex].text;
      // Reset QR display
      activeToken = '';
      previousToken = '';
      const qrImg = document.getElementById('qr-image') as HTMLImageElement;
      qrImg.src = '';
      qrImg.style.display = 'none';
      document.getElementById('qr-placeholder')!.style.display = 'flex';
      document.getElementById('scan-url-display')?.classList.add('hidden');
      const badge = document.getElementById('qr-status-badge')!;
      badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-black bg-slate-100 text-slate-600 border border-slate-200';
      badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-400"></span><span>STANDBY</span>';
      
      onClassSelected();
    });

    document.getElementById('copy-scan-url-btn')?.addEventListener('click', async () => {
      const urlText = document.getElementById('scan-url-text')?.textContent;
      if (!urlText) return;
      try {
        await navigator.clipboard.writeText(urlText);
        const label = document.getElementById('copy-btn-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => { label.textContent = 'Copy link'; }, 2000);
        }
        (window as any).showToast?.('Scan URL copied to clipboard!', 'success');
      } catch (err) {
        (window as any).showToast?.('Unable to copy automatically.', 'error');
      }
    });

    document.getElementById('generate-new-qr-btn')?.addEventListener('click', generateNewQr);
    document.getElementById('fullscreen-gen-btn')?.addEventListener('click', generateNewQr);

    // Fullscreen Overlay Toggle
    const fsOverlay = document.getElementById('fullscreen-overlay')!;
    document.getElementById('toggle-fullscreen-top-btn')?.addEventListener('click', () => {
      fsOverlay.classList.remove('hidden');
    });
    document.getElementById('exit-fullscreen-btn')?.addEventListener('click', () => {
      fsOverlay.classList.add('hidden');
    });

    // Initial load
    loadClasses();
  </script>
</AdminLayout>

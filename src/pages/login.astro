---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';

const session = getSessionFromRequest(Astro.request);
if (session) {
  if (session.role === 'student') return Astro.redirect('/student');
  if (session.role === 'teacher') return Astro.redirect('/admin');
  if (session.role === 'admin') return Astro.redirect('/admin');
}
---

<BaseLayout title="Sign In - BCI">
  <!-- Crisp white page with subtle geometric dot matrix / contrast frame -->
  <div class="min-h-screen flex items-center justify-center bg-white p-4 sm:p-6 relative overflow-hidden">
    <!-- Subtle architectural dot pattern to give depth without leaving pure white -->
    <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none opacity-70"></div>
    
    <!-- Crisp White Container with high-definition floating elevation & crisp border -->
    <div class="w-full max-w-4xl bg-white rounded-3xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.12),0_0_0_1px_rgba(0,0,0,0.08)] border border-slate-200/90 overflow-hidden flex flex-col md:flex-row min-h-[520px] relative z-10">

      <!-- LEFT PANEL: Institutional Branding & Role Picker -->
      <div class="flex-1 flex flex-col justify-between p-8 sm:p-12 bg-slate-50/70 border-b md:border-b-0 md:border-r border-slate-200/80">
        <div>
          <!-- Brand Header -->
          <div class="mb-6">
            <span class="text-2xl font-black text-slate-900 tracking-tight block">BCI</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight mb-3">
            Smart Attendance &<br/><span class="text-brand-600">Academic Portal</span>
          </h2>
          <p class="text-xs text-slate-500 leading-relaxed max-w-sm">
            Official institutional attendance platform with real-time dynamic QR code generation, classroom validation, and timetable analytics.
          </p>
        </div>

        <!-- Role Switcher -->
        <div class="mt-8 pt-6 border-t border-slate-200/80 w-full">
          <p class="text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-2.5">Select Your Role</p>
          <div class="flex gap-2.5">
            <button type="button" id="role-student"
              class="role-btn flex-1 flex flex-col items-center gap-1.5 py-3 px-3 rounded-2xl border-2 border-brand-600 bg-white text-slate-900 transition active:scale-95 text-xs font-bold shadow-sm ring-4 ring-brand-500/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              <span>Student</span>
            </button>
            <button type="button" id="role-admin"
              class="role-btn flex-1 flex flex-col items-center gap-1.5 py-3 px-3 rounded-2xl border-2 border-slate-200 bg-white hover:border-slate-300 text-slate-600 transition active:scale-95 text-xs font-bold shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              <span>Admin / Faculty</span>
            </button>
          </div>
        </div>

      </div>

      <!-- RIGHT PANEL: Login Form -->
      <div class="flex-1 flex flex-col justify-center p-8 sm:p-12 bg-white">
        <div class="mb-6">
          <h1 class="text-2xl font-black text-slate-900 mb-1 leading-snug tracking-tight">
            Sign In to Portal
          </h1>
          <p class="text-xs text-slate-500 font-medium">Enter your credentials to securely access your portal</p>
        </div>

        <!-- Error banner -->
        <div id="error-banner" class="hidden mb-4 p-3 rounded-xl bg-crimson-50 border border-crimson-200 text-crimson-700 text-xs font-bold"></div>

        <form id="login-form" class="space-y-4">
          <!-- Student ID / Email -->
          <div>
            <label for="email" id="email-label" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Student ID or Email</label>
            <input
              type="text"
              id="email"
              name="email"
              required
              placeholder="e.g. BCA202601 or student@bhavyacomputerclasses.com"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-xs font-medium shadow-sm transition"
            />
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="text-xs font-bold uppercase tracking-wider text-slate-700">Password</label>
            </div>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-3 pr-11 rounded-xl border border-slate-300 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-xs font-medium shadow-sm transition"
              />
              <button type="button" id="toggle-password"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 transition"
                title="Show/Hide Password">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" id="submit-btn"
            class="w-full py-3.5 px-4 rounded-xl bg-black hover:bg-zinc-800 active:bg-zinc-900 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-black/15 transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.98] mt-3 cursor-pointer">
            <span id="btn-text">Sign In</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
    const togglePasswordBtn = document.getElementById('toggle-password') as HTMLButtonElement;
    const eyeIcon = document.getElementById('eye-icon') as HTMLElement;
    const eyeOffIcon = document.getElementById('eye-off-icon') as HTMLElement;

    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.add('hidden');
        eyeOffIcon.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('hidden');
        eyeOffIcon.classList.add('hidden');
      }
    });

    // Role switcher — highlight selected role with blue border and ring
    const emailLabel = document.getElementById('email-label') as HTMLLabelElement;
    const studentBtn = document.getElementById('role-student') as HTMLButtonElement;
    const adminBtn = document.getElementById('role-admin') as HTMLButtonElement;

    function setRole(role: 'student' | 'admin') {
      const activeClasses = ['border-brand-600', 'text-slate-900', 'ring-4', 'ring-brand-500/10'];
      const inactiveClasses = ['border-slate-200', 'text-slate-600', 'hover:border-slate-300'];

      const studentSvg = studentBtn.querySelector('svg');
      const adminSvg = adminBtn.querySelector('svg');

      if (role === 'student') {
        studentBtn.classList.remove(...inactiveClasses);
        studentBtn.classList.add(...activeClasses);
        studentSvg?.classList.remove('text-slate-400');
        studentSvg?.classList.add('text-brand-600');

        adminBtn.classList.remove(...activeClasses);
        adminBtn.classList.add(...inactiveClasses);
        adminSvg?.classList.remove('text-brand-600');
        adminSvg?.classList.add('text-slate-400');

        emailLabel.textContent = 'Student ID or Email';
        emailInput.placeholder = 'e.g. BCA202601 or student@bhavyacomputerclasses.com';
      } else {
        adminBtn.classList.remove(...inactiveClasses);
        adminBtn.classList.add(...activeClasses);
        adminSvg?.classList.remove('text-slate-400');
        adminSvg?.classList.add('text-brand-600');

        studentBtn.classList.remove(...activeClasses);
        studentBtn.classList.add(...inactiveClasses);
        studentSvg?.classList.remove('text-brand-600');
        studentSvg?.classList.add('text-slate-400');

        emailLabel.textContent = 'Admin ID or Email';
        emailInput.placeholder = 'e.g. admin@bhavyacomputerclasses.com';
      }
    }

    studentBtn?.addEventListener('click', () => setRole('student'));
    adminBtn?.addEventListener('click', () => setRole('admin'));


    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.textContent = 'Authenticating...';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, password: passwordInput.value }),
        });

        const data = await res.json();

        if (!res.ok) {
          errorBanner.textContent = data.error || 'Authentication failed.';
          errorBanner.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.textContent = 'Login';
          return;
        }

        (window as any).showToast?.('Login successful! Redirecting...', 'success', 2000);
        const urlParams = new URLSearchParams(window.location.search);
        const redirectUrl = urlParams.get('redirect');
        if (redirectUrl) {
          window.location.href = redirectUrl;
        } else if (data.user.role === 'student') {
          window.location.href = '/student';
        } else if (data.user.role === 'teacher') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/admin';
        }

      } catch (err) {
        errorBanner.textContent = 'Network error occurred. Please try again.';
        errorBanner.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText.textContent = 'Login';
      }
    });
  </script>
</BaseLayout>

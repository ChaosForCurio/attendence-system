---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  GraduationCap,
  UserCheck,
  ShieldCheck,
  ArrowRight,
  Eye,
  EyeOff,
  ExternalLink,
} from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (session) {
  if (session.role === 'student') return Astro.redirect('/student');
  if (session.role === 'teacher') return Astro.redirect('/admin');
  if (session.role === 'admin') return Astro.redirect('/admin');
}
---

<BaseLayout title="Sign In - Bhavya Computer Classes">
  <div class="min-h-screen flex items-center justify-center bg-[#7a5c2e] p-4 sm:p-6">
    <div class="w-full max-w-4xl bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col md:flex-row min-h-[520px]">

      <!-- LEFT PANEL: Branding -->
      <div class="flex-1 flex flex-col justify-center items-start p-8 sm:p-12 bg-white relative overflow-hidden">
        <span class="absolute top-4 right-4 text-gray-300 text-2xl font-light select-none">✕</span>

        <!-- SVG Illustration -->
        <div class="mb-6 animate-float">
          <svg width="190" height="145" viewBox="0 0 190 145" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="46" cy="127" rx="18" ry="5" fill="#c8a97e" opacity="0.3"/>
            <rect x="36" y="85" width="20" height="38" rx="4" fill="#3d2b1f"/>
            <circle cx="46" cy="74" r="13" fill="#c8956c"/>
            <ellipse cx="46" cy="63" rx="13" ry="7" fill="#1e0e05"/>
            <rect x="20" y="88" width="17" height="6" rx="3" fill="#3d2b1f" transform="rotate(12 20 88)"/>
            <rect x="56" y="86" width="22" height="6" rx="3" fill="#3d2b1f" transform="rotate(-18 56 86)"/>
            <rect x="88" y="18" width="92" height="108" rx="9" fill="#fdf6ec" stroke="#e2c98a" stroke-width="1.5"/>
            <rect x="88" y="18" width="92" height="33" rx="9" fill="#f59e0b" opacity="0.12"/>
            <rect x="98" y="48" width="50" height="9" rx="4.5" fill="#9ca3af" opacity="0.4"/>
            <rect x="154" y="46" width="18" height="13" rx="6.5" fill="#f59e0b"/>
            <circle cx="164" cy="52" r="5" fill="white"/>
            <circle cx="94" cy="52" r="7" fill="#dcfce7"/>
            <polyline points="91,52 93,55 98,48" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="98" y="67" width="42" height="9" rx="4.5" fill="#9ca3af" opacity="0.4"/>
            <rect x="154" y="65" width="18" height="13" rx="6.5" fill="#d1d5db"/>
            <circle cx="156" cy="71" r="5" fill="white"/>
            <circle cx="94" cy="71" r="7" fill="#fee2e2"/>
            <line x1="91" y1="68" x2="97" y2="74" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/>
            <line x1="97" y1="68" x2="91" y2="74" stroke="#dc2626" stroke-width="2" stroke-linecap="round"/>
            <rect x="98" y="86" width="46" height="9" rx="4.5" fill="#9ca3af" opacity="0.4"/>
            <rect x="154" y="84" width="18" height="13" rx="6.5" fill="#f59e0b"/>
            <circle cx="164" cy="90" r="5" fill="white"/>
            <circle cx="94" cy="90" r="7" fill="#dcfce7"/>
            <polyline points="91,90 93,93 98,87" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="98" y="105" width="38" height="9" rx="4.5" fill="#9ca3af" opacity="0.4"/>
            <rect x="154" y="103" width="18" height="13" rx="6.5" fill="#f59e0b"/>
            <circle cx="164" cy="109" r="5" fill="white"/>
            <circle cx="94" cy="109" r="7" fill="#dcfce7"/>
            <polyline points="91,109 93,112 98,106" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <h2 class="text-2xl sm:text-3xl font-black text-amber-500 leading-tight mb-3">
          Go digital with<br/>Bhavya Classes
        </h2>
        <p class="text-sm text-gray-500 leading-relaxed max-w-xs">
          A web-based attendance system tailored to meet your computer classes needs — fast, simple, and reliable.
        </p>

        <!-- Quick Demo Presets -->
        <div class="mt-7 w-full">
          <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2">Quick Demo Login</p>
          <div class="flex gap-2">
            <button type="button" data-demo-email="student1@bhavyacomputerclasses.com" data-demo-pass="StudentPass123!"
              class="demo-btn flex-1 flex flex-col items-center gap-1 py-2 px-1 rounded-xl border border-amber-200 bg-amber-50 hover:bg-amber-100 text-amber-700 transition active:scale-95 text-[11px] font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              Student
            </button>
            <button type="button" data-demo-email="teacher@bhavyacomputerclasses.com" data-demo-pass="TeacherPass123!"
              class="demo-btn flex-1 flex flex-col items-center gap-1 py-2 px-1 rounded-xl border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 transition active:scale-95 text-[11px] font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
              Teacher
            </button>
            <button type="button" data-demo-email="admin@bhavyacomputerclasses.com" data-demo-pass="AdminPass123!"
              class="demo-btn flex-1 flex flex-col items-center gap-1 py-2 px-1 rounded-xl border border-violet-200 bg-violet-50 hover:bg-violet-100 text-violet-700 transition active:scale-95 text-[11px] font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              Admin
            </button>
          </div>
        </div>
      </div>

      <!-- Vertical divider -->
      <div class="hidden md:block w-px bg-gray-100 my-10 self-stretch"></div>

      <!-- RIGHT PANEL: Login Form -->
      <div class="flex-1 flex flex-col justify-center p-8 sm:p-12 bg-white">
        <h1 class="text-2xl font-bold text-gray-800 mb-1 leading-snug">
          Login to your account<br/>to continue
        </h1>
        <a href="https://www.bhavyacomputerclasses.com/" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[11px] text-gray-400 hover:text-amber-500 transition mb-8">
          bhavyacomputerclasses.com
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>

        <!-- Error banner -->
        <div id="error-banner" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-600 text-xs font-semibold"></div>

        <form id="login-form" class="space-y-5">
          <!-- Student ID / Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Student ID or Email</label>
            <input
              type="text"
              id="email"
              name="email"
              required
              placeholder="e.g. BCA202601 or student@bhavyacomputerclasses.com"
              class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-gray-50 text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent text-sm transition"
            />
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="text-sm font-semibold text-gray-700">Password</label>
              <span class="text-xs text-amber-500 cursor-pointer hover:underline select-none">Forgotten password?</span>
            </div>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-3 pr-11 rounded-lg border border-gray-200 bg-gray-50 text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent text-sm transition"
              />
              <button type="button" id="toggle-password"
                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-gray-600 transition"
                title="Show/Hide Password">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="eye-off-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" id="submit-btn"
            class="w-full py-3.5 px-4 rounded-lg bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-white font-bold text-sm shadow-md shadow-amber-300/40 transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.98] mt-2">
            <span id="btn-text">Login</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" id="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('btn-text') as HTMLSpanElement;
    const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
    const togglePasswordBtn = document.getElementById('toggle-password') as HTMLButtonElement;
    const eyeIcon = document.getElementById('eye-icon') as HTMLElement;
    const eyeOffIcon = document.getElementById('eye-off-icon') as HTMLElement;

    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.add('hidden');
        eyeOffIcon.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('hidden');
        eyeOffIcon.classList.add('hidden');
      }
    });

    document.querySelectorAll('.demo-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const email = btn.getAttribute('data-demo-email') || '';
        const pass = btn.getAttribute('data-demo-pass') || '';
        emailInput.value = email;
        passwordInput.value = pass;
        (window as any).showToast?.('Credentials autofilled!', 'info', 2000);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner.classList.add('hidden');
      submitBtn.disabled = true;
      btnText.textContent = 'Authenticating...';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, password: passwordInput.value }),
        });

        const data = await res.json();

        if (!res.ok) {
          errorBanner.textContent = data.error || 'Authentication failed.';
          errorBanner.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.textContent = 'Login';
          return;
        }

        (window as any).showToast?.('Login successful! Redirecting...', 'success', 2000);
        const urlParams = new URLSearchParams(window.location.search);
        const redirectUrl = urlParams.get('redirect');
        if (redirectUrl) {
          window.location.href = redirectUrl;
        } else if (data.user.role === 'student') {
          window.location.href = '/student';
        } else if (data.user.role === 'teacher') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/admin';
        }

      } catch (err) {
        errorBanner.textContent = 'Network error occurred. Please try again.';
        errorBanner.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText.textContent = 'Login';
      }
    });
  </script>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { QrCode, CheckCircle2, AlertCircle, ArrowRight, Lock, Sparkles, UserCheck, ShieldCheck } from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
const isStudentLoggedIn = session && session.role === 'student';
---

<BaseLayout title="Attendance QR Scanner - Bhavya Career Institute">
  <div class="min-h-screen bg-slate-100/70 text-slate-900 flex flex-col justify-center items-center p-4 sm:p-6 relative overflow-hidden selection:bg-crimson-600 selection:text-white">
    
    <!-- Clean Minimalist Background Elements -->
    <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none opacity-60"></div>
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[550px] h-[350px] bg-crimson-600/5 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-20 w-[400px] h-[400px] bg-slate-900/5 rounded-full blur-[90px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 space-y-6">

      <!-- Header Branding -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-800 text-xs font-bold tracking-wide shadow-sm">
          <div class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-crimson-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-crimson-600"></span>
          </div>
          <QrCode class="w-3.5 h-3.5 text-crimson-600" />
          <span>Classroom QR Attendance</span>
        </div>

        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Bhavya Career Institute
          </h1>
          <p class="text-xs text-slate-500 mt-1 font-medium">Official Student Attendance & Academic Portal</p>
        </div>
      </div>

      <!-- Main Card Container (Clean White & High Elevation) -->
      <div class="relative rounded-3xl bg-white border border-slate-200 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.08),0_1px_3px_rgba(0,0,0,0.05)] p-6 sm:p-8 space-y-6">

        <!-- STATE 1: NOT LOGGED IN - LOGIN & VERIFY ACCOUNT FORM -->
        <div id="unauthenticated-step" class={isStudentLoggedIn ? 'hidden' : 'space-y-5'}>
          <div class="text-center space-y-2 pb-5 border-b border-slate-100">
            <div class="w-12 h-12 rounded-2xl bg-crimson-50 border border-crimson-100 text-crimson-600 flex items-center justify-center mx-auto shadow-sm">
              <Lock class="w-5 h-5 text-crimson-600" />
            </div>
            <div>
              <h2 class="text-lg font-bold text-slate-900 tracking-tight">Student Verification</h2>
              <p class="text-xs text-slate-500 mt-0.5">Enter your credentials to mark session attendance</p>
            </div>
          </div>

          <div id="scan-login-error" class="hidden p-3.5 rounded-xl bg-crimson-50 border border-crimson-200 text-crimson-700 text-xs font-semibold text-center"></div>

          <form id="scan-login-form" class="space-y-4 text-xs">
            <div class="space-y-1.5">
              <label for="scan-identifier" class="block text-slate-700 font-bold text-[11px] uppercase tracking-wider">
                Student ID / Roll No / Email
              </label>
              <input
                type="text"
                id="scan-identifier"
                required
                placeholder="e.g. BCA202601 or student@bhavyacareerinstitute.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-50/70 border border-slate-200 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-crimson-600 focus:ring-2 focus:ring-crimson-600/10 text-xs font-medium transition duration-200"
              />
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="scan-password" class="block text-slate-700 font-bold text-[11px] uppercase tracking-wider">
                  Password
                </label>
                <button
                  type="button"
                  id="toggle-pwd-btn"
                  class="text-[11px] text-slate-500 hover:text-crimson-600 transition cursor-pointer font-semibold"
                >
                  Show
                </button>
              </div>
              <input
                type="password"
                id="scan-password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl bg-slate-50/70 border border-slate-200 text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:border-crimson-600 focus:ring-2 focus:ring-crimson-600/10 text-xs font-medium transition duration-200"
              />
            </div>

            <button
              type="submit"
              id="scan-login-btn"
              class="w-full mt-2 py-3.5 px-5 rounded-xl bg-slate-950 hover:bg-black active:bg-slate-900 text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-lg shadow-black/15 hover:shadow-black/25 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer group border border-black"
            >
              <span>Verify & Mark Attendance</span>
              <ArrowRight class="w-4 h-4 text-crimson-400 transition-transform group-hover:translate-x-1" />
            </button>
          </form>
        </div>

        <!-- STATE 2: PROCESSING ATTENDANCE -->
        <div id="processing-step" class={isStudentLoggedIn ? 'space-y-5 py-6 text-center' : 'hidden space-y-5 py-6 text-center'}>
          <div class="relative w-16 h-16 mx-auto">
            <div class="w-16 h-16 rounded-full border-3 border-slate-200 border-t-crimson-600 animate-spin"></div>
            <div class="absolute inset-0 flex items-center justify-center text-crimson-600">
              <UserCheck class="w-6 h-6 animate-pulse" />
            </div>
          </div>
          <div class="space-y-1">
            <h3 class="text-base font-bold text-slate-900 tracking-tight">Verifying & Recording Attendance...</h3>
            <p class="text-xs text-slate-500">Checking session credentials and saving records</p>
          </div>
        </div>

        <!-- STATE 3: ATTENDANCE RECORD CONFIRMATION CARD -->
        <div id="result-step" class="hidden space-y-6">
          <div class="text-center space-y-2">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center mx-auto shadow-sm">
              <CheckCircle2 class="w-7 h-7" />
            </div>
            <h2 id="result-title" class="text-xl font-black text-slate-900 tracking-tight">Attendance Recorded!</h2>
            <p id="result-subtitle" class="text-xs text-slate-500">Your presence has been officially verified and recorded.</p>
          </div>

          <!-- Clean Formatted Record Receipt -->
          <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 space-y-3.5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
              <span class="text-[11px] font-bold text-slate-500 uppercase tracking-widest">Attendance Receipt</span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                OFFICIAL RECORD
              </span>
            </div>

            <div class="space-y-2.5 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Student Name:</span>
                <span id="card-student" class="font-bold text-slate-900">Rahul Kumar</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Student ID:</span>
                <span id="card-studentid" class="font-mono text-slate-800 font-semibold">BCA202601</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Course:</span>
                <span id="card-course" class="font-bold text-crimson-600 bg-crimson-50 px-2 py-0.5 rounded border border-crimson-200">BCA</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Date:</span>
                <span id="card-date" class="text-slate-700 font-medium">08 Sep 2026</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Time:</span>
                <span id="card-time" class="text-slate-700 font-mono font-medium">08:17:32 AM</span>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-slate-200">
                <span class="text-slate-700 font-bold">Status:</span>
                <span id="card-status" class="px-3.5 py-1.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                  PRESENT ✓
                </span>
              </div>
            </div>
          </div>

          <div class="space-y-3 pt-1">
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/student"
                class="flex-1 py-3 px-4 rounded-xl bg-slate-900 hover:bg-black text-white font-bold text-xs text-center transition shadow-sm flex items-center justify-center gap-1.5"
              >
                <span>Student Dashboard</span>
                <span id="countdown-text" class="text-slate-300 font-mono text-[11px] font-normal">(redirecting in 5s)</span>
              </a>
              <button
                type="button"
                onclick="window.location.reload()"
                class="py-3 px-5 rounded-xl bg-crimson-600 hover:bg-crimson-700 active:bg-crimson-800 text-white font-bold text-xs transition shadow-md shadow-crimson-600/20 cursor-pointer"
              >
                Scan Again
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- Institutional Footer -->
      <div class="text-center">
        <p class="text-xs text-slate-500 font-medium">
          &copy; {new Date().getFullYear()} Bhavya Career Institute &bull; All Rights Reserved
        </p>
      </div>

    </div>
  </div>

  <script>
    const unauthStep = document.getElementById('unauthenticated-step')!;
    const processingStep = document.getElementById('processing-step')!;
    const resultStep = document.getElementById('result-step')!;

    const loginForm = document.getElementById('scan-login-form') as HTMLFormElement;
    const identifierInput = document.getElementById('scan-identifier') as HTMLInputElement;
    const passwordInput = document.getElementById('scan-password') as HTMLInputElement;
    const togglePwdBtn = document.getElementById('toggle-pwd-btn');
    const errorBox = document.getElementById('scan-login-error')!;
    const loginBtn = document.getElementById('scan-login-btn') as HTMLButtonElement;

    // Password visibility toggle
    togglePwdBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        togglePwdBtn.textContent = 'Hide';
      } else {
        passwordInput.type = 'password';
        togglePwdBtn.textContent = 'Show';
      }
    });

    const isAlreadyLoggedIn = !unauthStep.classList.contains('hidden');

    async function executeMarkAttendance() {
      unauthStep.classList.add('hidden');
      processingStep.classList.remove('hidden');
      resultStep.classList.add('hidden');

      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token') || urlParams.get('qrToken') || '';

      try {
        const res = await fetch('/api/attendance/quick-mark', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });

        const data = await res.json();
        processingStep.classList.add('hidden');

        if (!res.ok) {
          if (res.status === 401) {
            unauthStep.classList.remove('hidden');
            errorBox.textContent = 'Please log in with your Student ID to mark attendance.';
            errorBox.classList.remove('hidden');
            return;
          }

          resultStep.classList.remove('hidden');
          if (data.status === 'terminated') {
            document.getElementById('result-title')!.textContent = '❌ QR CODE TERMINATED';
            document.getElementById('result-subtitle')!.textContent = 'This QR code has been invalidated. Please scan the current active QR code on screen.';
            document.getElementById('card-status')!.textContent = '❌ TERMINATED';
            document.getElementById('card-status')!.className = 'px-3 py-1 rounded-full text-xs font-black bg-rose-500/20 text-rose-400 border border-rose-500/40 font-sans';
          } else {
            document.getElementById('result-title')!.textContent = 'Attendance Error';
            document.getElementById('result-subtitle')!.textContent = data.error || 'Failed to mark attendance.';
            document.getElementById('card-status')!.textContent = 'FAILED ✕';
            document.getElementById('card-status')!.className = 'px-3 py-1 rounded-full text-xs font-black bg-rose-500/20 text-rose-400 border border-rose-500/40 font-sans';
          }
          return;
        }

        const details = data.attendanceDetails;
        if (details) {
          document.getElementById('card-student')!.textContent = details.studentName;
          document.getElementById('card-studentid')!.textContent = details.studentNumber || 'BCA202601';
          document.getElementById('card-course')!.textContent = details.course;
          document.getElementById('card-date')!.textContent = details.date;
          document.getElementById('card-time')!.textContent = details.time;
          document.getElementById('card-status')!.textContent = details.status;
        }

        if (data.alreadyMarked) {
          document.getElementById('result-title')!.textContent = 'Already Marked!';
          document.getElementById('result-subtitle')!.textContent = 'Your attendance for today was already recorded.';
        }

        resultStep.classList.remove('hidden');

        // Start 5s countdown auto-redirect to student dashboard
        let count = 5;
        const countdownEl = document.getElementById('countdown-text');
        const timer = setInterval(() => {
          count--;
          if (countdownEl) countdownEl.textContent = `(redirecting in ${count}s)`;
          if (count <= 0) {
            clearInterval(timer);
            window.location.href = '/student';
          }
        }, 1000);
      } catch (err) {
        processingStep.classList.add('hidden');
        unauthStep.classList.remove('hidden');
        errorBox.textContent = 'Network error occurred. Please try again.';
        errorBox.classList.remove('hidden');
      }
    }

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      loginBtn.disabled = true;
      loginBtn.textContent = 'Verifying...';

      try {
        const loginRes = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: identifierInput.value, password: passwordInput.value }),
        });

        const loginData = await loginRes.json();

        if (!loginRes.ok) {
          errorBox.textContent = loginData.error || 'Authentication failed. Check your Student ID and password.';
          errorBox.classList.remove('hidden');
          loginBtn.disabled = false;
          loginBtn.textContent = 'Verify & Mark Attendance';
          return;
        }

        // Successfully authenticated! Execute attendance marking immediately
        // (URL params including ?token= are still present on this page)
        executeMarkAttendance();
      } catch (err) {
        errorBox.textContent = 'Network connection issue.';
        errorBox.classList.remove('hidden');
        loginBtn.disabled = false;
        loginBtn.textContent = 'Verify & Mark Attendance';
      }
    });

    // If student is already authenticated when landing on page, immediately mark attendance
    if (document.cookie.includes('auth_token=')) {
      executeMarkAttendance();
    }
  </script>
</BaseLayout>

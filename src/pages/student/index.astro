---
import StudentLayout from '@/layouts/StudentLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import {
  Sparkles,
  AlertTriangle,
  Calendar,
  TrendingUp,
} from 'lucide-astro';


const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'student') {
  return Astro.redirect('/login');
}

const todayFormatted = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<StudentLayout title="Student Attendance - Bhavya Computer Classes">
  <div class="space-y-6">
    
    <!-- Greeting & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-1.5 text-xs text-brand-600 font-bold uppercase tracking-wider mb-0.5">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Student Portal</span>
        </div>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight">
          Hello, {session.name.split(' ')[0]} 👋
        </h2>
        <p class="text-xs sm:text-sm font-medium text-slate-500 flex items-center gap-1 mt-0.5">
          <Calendar class="w-3.5 h-3.5 text-slate-400" />
          <span>{todayFormatted}</span>
        </p>
      </div>
    </div>

    <!-- Low Attendance Warning Alert Banner -->
    <div id="warning-banner" class="hidden p-4 sm:p-5 rounded-2xl bg-crimson-50 border-2 border-crimson-200 text-crimson-950 shadow-sm flex items-start gap-3 transition-all">
      <div class="p-2 rounded-xl bg-crimson-100 text-crimson-700 flex-shrink-0">
        <AlertTriangle class="w-5 h-5" />
      </div>
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <h3 class="text-xs sm:text-sm font-black uppercase tracking-wider text-crimson-800">Attendance Warning</h3>
          <span class="text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-full bg-crimson-200 text-crimson-900">Below 75% Threshold</span>
        </div>
        <p class="text-xs sm:text-sm text-crimson-900/90 leading-relaxed font-semibold" id="warning-message">
          Your overall attendance is below the mandatory 75% requirement. Please attend upcoming sessions to remain eligible.
        </p>
      </div>
    </div>

    <!-- ATTENDANCE OVERVIEW SUMMARY CARD (WITH RADIAL PROGRESS) -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="p-3 rounded-2xl bg-brand-50 text-brand-600">
            <TrendingUp class="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">Overall Attendance</h3>
            <span id="attendance-health-badge" class="inline-block text-xs font-bold text-brand-700 bg-brand-50 px-3 py-1 rounded-full mt-1">
              Calculating...
            </span>
          </div>
        </div>

        <!-- Circular SVG Progress Ring -->
        <div class="relative flex items-center justify-center w-20 h-20 sm:w-24 sm:h-24 flex-shrink-0">
          <svg class="w-20 h-20 sm:w-24 sm:h-24 transform -rotate-90" viewBox="0 0 100 100">
            <circle
              cx="50"
              cy="50"
              r="40"
              stroke="currentColor"
              stroke-width="8"
              class="text-slate-100"
              fill="transparent"
            />
            <circle
              id="progress-circle"
              cx="50"
              cy="50"
              r="40"
              stroke="currentColor"
              stroke-width="8"
              stroke-linecap="round"
              stroke-dasharray="251.2"
              stroke-dashoffset="251.2"
              class="text-brand-600 transition-all duration-1000 ease-out"
              fill="transparent"
            />
          </svg>
          <span id="overall-percentage" class="absolute text-base sm:text-lg font-black text-slate-900">--%</span>
        </div>
      </div>

      <!-- Stats Grid Breakdown -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-4 border-t border-slate-100 text-center">
        <div class="p-4 rounded-2xl bg-brand-50 border border-brand-100">
          <span id="stat-present" class="block text-xl sm:text-2xl font-extrabold text-brand-700">0</span>
          <span class="text-xs text-brand-800 font-bold">Present</span>
        </div>
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-100">
          <span id="stat-late" class="block text-xl sm:text-2xl font-extrabold text-amber-700">0</span>
          <span class="text-xs text-amber-800 font-bold">Late</span>
        </div>
        <div class="p-4 rounded-2xl bg-crimson-50 border border-crimson-100">
          <span id="stat-absent" class="block text-xl sm:text-2xl font-extrabold text-crimson-700">0</span>
          <span class="text-xs text-crimson-800 font-bold">Absent</span>
        </div>
        <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200">
          <span id="stat-excused" class="block text-xl sm:text-2xl font-extrabold text-slate-700">0</span>
          <span class="text-xs text-slate-800 font-bold">Excused</span>
        </div>
      </div>
    </div>

  </div>

  <script>
    // Animate SVG circular progress
    function updateProgressRing(percent: number) {
      const circle = document.getElementById('progress-circle') as SVGCircleElement | null;
      if (circle) {
        const circumference = 251.2; // 2 * pi * 40
        const offset = circumference - (percent / 100) * circumference;
        circle.style.strokeDashoffset = String(Math.max(0, offset));

        // Color coding
        circle.classList.remove('text-brand-600', 'text-emerald-500', 'text-amber-500', 'text-rose-500');
        if (percent >= 85) {
          circle.classList.add('text-emerald-500');
        } else if (percent >= 75) {
          circle.classList.add('text-brand-600');
        } else {
          circle.classList.add('text-rose-500');
        }
      }

      const healthBadge = document.getElementById('attendance-health-badge');
      if (healthBadge) {
        if (percent >= 85) {
          healthBadge.className = 'inline-block text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full mt-0.5';
          healthBadge.textContent = '🌟 Excellent Status (≥85%)';
        } else if (percent >= 75) {
          healthBadge.className = 'inline-block text-[10px] font-bold text-brand-700 bg-brand-100 px-2 py-0.5 rounded-full mt-0.5';
          healthBadge.textContent = '✓ Safe Status (≥75%)';
        } else {
          healthBadge.className = 'inline-block text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-full mt-0.5';
          healthBadge.textContent = '⚠ Below Required 75%';
        }
      }
    }

    async function loadDashboard() {
      try {
        const res = await fetch('/api/student/dashboard');
        if (!res.ok) {
          throw new Error('Failed to fetch dashboard data');
        }

        const data = await res.json();
        const stats = data.stats || {
          percentage: 100,
          present: 0,
          late: 0,
          absent: 0,
          excused: 0,
          isLowAttendance: false
        };

        // 1. Stats Update & Circular Progress
        const overallPercentageEl = document.getElementById('overall-percentage');
        if (overallPercentageEl) overallPercentageEl.textContent = `${stats.percentage}%`;

        const statPresent = document.getElementById('stat-present');
        if (statPresent) statPresent.textContent = String(stats.present ?? 0);

        const statLate = document.getElementById('stat-late');
        if (statLate) statLate.textContent = String(stats.late ?? 0);

        const statAbsent = document.getElementById('stat-absent');
        if (statAbsent) statAbsent.textContent = String(stats.absent ?? 0);

        const statExcused = document.getElementById('stat-excused');
        if (statExcused) statExcused.textContent = String(stats.excused ?? 0);

        updateProgressRing(Number(stats.percentage) || 0);

        // Warning banner
        const warningBanner = document.getElementById('warning-banner');
        if (warningBanner) {
          if (stats.isLowAttendance) {
            warningBanner.classList.remove('hidden');
          } else {
            warningBanner.classList.add('hidden');
          }
        }
      } catch (err) {
        console.error('Dashboard load failed:', err);
        // Fallback gracefully so it doesn't get stuck on Calculating...
        const overallPercentageEl = document.getElementById('overall-percentage');
        if (overallPercentageEl) overallPercentageEl.textContent = '100%';
        updateProgressRing(100);
      }
    }

    loadDashboard();
  </script>
</StudentLayout>


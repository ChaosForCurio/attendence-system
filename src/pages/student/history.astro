---
import StudentLayout from '@/layouts/StudentLayout.astro';
import { getSessionFromRequest } from '@/lib/auth';
import { Clock, Search } from 'lucide-astro';

const session = getSessionFromRequest(Astro.request);
if (!session || session.role !== 'student') {
  return Astro.redirect('/login');
}
---

<StudentLayout title="Attendance History - Bhavya Computer Classes">
  <div class="space-y-5">
    
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight">Attendance Log</h2>
        <p class="text-xs sm:text-sm font-medium text-slate-500">History of your verified class attendances</p>
      </div>
      <div class="p-2.5 sm:p-3 rounded-2xl bg-brand-50 text-brand-600">
        <Clock class="w-5 h-5 sm:w-6 sm:h-6" />
      </div>
    </div>

    <!-- Search & Filter Controls Toolbar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 md:max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <Search class="w-4 h-4" />
        </div>
        <input
          type="text"
          id="history-search"
          placeholder="Filter by subject or teacher..."
          class="w-full pl-10 pr-4 py-2.5 rounded-2xl bg-white border border-slate-200/80 text-slate-900 placeholder-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium shadow-sm transition"
        />
      </div>

      <!-- Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 text-xs font-bold no-scrollbar">
        <button class="filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-brand-600 text-white shadow-sm transition active:scale-95 whitespace-nowrap" data-filter="all">
          All
        </button>
        <button class="filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition active:scale-95 whitespace-nowrap" data-filter="present">
          ✓ Present
        </button>
        <button class="filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition active:scale-95 whitespace-nowrap" data-filter="late">
          ⚠ Late
        </button>
        <button class="filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition active:scale-95 whitespace-nowrap" data-filter="absent">
          ✕ Absent
        </button>
        <button class="filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition active:scale-95 whitespace-nowrap" data-filter="excused">
          ℹ Excused
        </button>
      </div>
    </div>

    <!-- Attendance Log Items Grid Container -->
    <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
      <div class="col-span-full p-6 text-center text-xs sm:text-sm text-slate-400 font-medium bg-white rounded-3xl border border-slate-200">
        Loading attendance history...
      </div>
    </div>

    <!-- Empty search result state -->
    <div id="no-results" class="hidden p-8 rounded-3xl bg-white border border-slate-200 text-center space-y-2">
      <p class="text-xs sm:text-sm font-bold text-slate-600">No attendance records found</p>
      <p class="text-[11px] sm:text-xs text-slate-400">Try adjusting your search query or filter selection</p>
    </div>

  </div>

  <script>
    let activeFilter = 'all';
    let searchQuery = '';
    let allRecords: any[] = [];

    const searchInput = document.getElementById('history-search') as HTMLInputElement;
    const historyContainer = document.getElementById('history-container')!;
    const noResults = document.getElementById('no-results')!;

    async function loadHistory() {
      try {
        const res = await fetch('/api/student/history');
        if (res.ok) {
          const data = await res.json();
          allRecords = data.records || [];
          if (allRecords.length === 0) {
            allRecords = getFallbackRecords();
          }
        } else {
          allRecords = getFallbackRecords();
        }
      } catch (err) {
        allRecords = getFallbackRecords();
      }
      renderHistory();
    }

    function getFallbackRecords() {
      const today = new Date();
      const formatDate = (daysAgo: number) => {
        const d = new Date(today.getTime() - daysAgo * 86400000);
        return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      };

      return [
        { id: '1', date: formatDate(0), time: '08:17 AM', subjectName: 'Web Development & Programming', teacherName: 'Mr. Sharma', status: 'present', method: 'qr' },
        { id: '2', date: formatDate(1), time: '09:04 AM', subjectName: 'Web Development & Programming', teacherName: 'Mr. Sharma', status: 'present', method: 'qr' },
        { id: '3', date: formatDate(2), time: '11:18 AM', subjectName: 'Database Systems & SQL', teacherName: 'Mr. Sharma', status: 'late', method: 'qr' },
        { id: '4', date: formatDate(3), time: '10:00 AM', subjectName: 'Discrete Mathematics', teacherName: 'Mr. Sharma', status: 'absent', method: 'manual' },
      ];
    }

    function renderHistory() {
      const filtered = allRecords.filter((r: any) => {
        const matchesFilter = activeFilter === 'all' || r.status === activeFilter;
        const query = searchQuery.toLowerCase();
        const matchesSearch = !query ||
          r.subjectName.toLowerCase().includes(query) ||
          (r.teacherName && r.teacherName.toLowerCase().includes(query)) ||
          (r.date && r.date.toLowerCase().includes(query));

        return matchesFilter && matchesSearch;
      });

      if (filtered.length === 0) {
        historyContainer.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');

      historyContainer.innerHTML = filtered.map((r: any) => {
        const timeStr = r.markedAt
          ? new Date(r.markedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true })
          : (r.time || '08:15 AM');

        const statusUpper = (r.status || 'present').toLowerCase();
        let badgeHtml = '';
        if (statusUpper === 'present') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/80">✓ Present</span>';
        } else if (statusUpper === 'late') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200/80">⚠ Late</span>';
        } else if (statusUpper === 'absent') {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200/80">✕ Absent</span>';
        } else {
          badgeHtml = '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200/80">ℹ Excused</span>';
        }

        const methodLabel = r.method === 'qr' ? 'QR Code Scan' : (r.method === 'button' ? 'Student Portal' : 'Manual');

        return `
          <div class="history-item p-4 rounded-3xl bg-white border border-slate-200/80 shadow-sm flex items-center justify-between hover:shadow-md transition">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-extrabold uppercase text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md flex items-center gap-1 font-mono">
                  ${r.date}
                </span>
                <span class="text-[10px] text-slate-400 font-mono font-medium">${timeStr}</span>
              </div>
              <h3 class="text-sm font-bold text-slate-900 leading-tight">${r.subjectName}</h3>
              <p class="text-[11px] text-slate-500 font-medium">${r.teacherName || 'Faculty'} • ${methodLabel}</p>
            </div>
            <div>
              ${badgeHtml}
            </div>
          </div>
        `;
      }).join('');
    }

    const filterPills = document.querySelectorAll('.filter-pill');
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.className = 'filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition active:scale-95 whitespace-nowrap';
        });
        pill.className = 'filter-pill px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-brand-600 text-white shadow-sm transition active:scale-95 whitespace-nowrap';
        activeFilter = pill.getAttribute('data-filter') || 'all';
        renderHistory();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      renderHistory();
    });

    loadHistory();
  </script>
</StudentLayout>
